Questions to consider:
• Is the configured range appropriate for this patient?
• Are timing, measurement technique, and source quality comparable?
• Could missing reports or a different measurement setting affect interpretation?
• Do symptoms or other verified clinical records provide relevant context?

These observations do not establish a cause, diagnosis, or treatment recommendation.`;
}
function assistantSummary(c){
  if(c.section==="billing"&&!c.focused)return billingAssistantAnswer();
  return `${c.p.name} — ${c.scope==="clinic"?"clinic record":"selected home-monitoring view"}.

${c.observations.map(x=>`• ${x.def.label}: ${x.latest?fmt(x.latest.value)+" "+x.def.unit+" on "+x.latest.date:"unavailable"}${x.flagged?" — outside configured review range":""}.`).join("\n")}

${c.scope==="home"?`Reporting coverage: ${aggregate(c.ds).answered}/${c.ds.length} days. Listed values are the latest available daily plotted values, not necessarily the period totals shown on cards.`:"Clinic records are independent of appointment/home-monitoring data."}

${c.section==="analytics"?"Forecasts are illustrative and are not included as observed patient measurements.":""}
No absence of a flag should be interpreted as a clinical all-clear.`;
}
function forecastAssistantAnswer(){
  return "The forecast estimates reporting-adjusted weekly burden, not a validated clinical outcome.\n\n• Each full week needs at least five reporting days.\n• Positive/reporting days are scaled to seven; missing outcomes are not observed.\n• Four consecutive eligible weeks are needed for extrapolation.\n• Historical backtesting compares the same rule with a prior-week baseline.\n• The shaded band is a heuristic, not a confidence interval.\n• Reporting bias and serial dependence are not corrected.\n\nThe next-week horizon follows November 6, 2026, not today's date. Correlations are also synthetic and deliberately encoded by the generator; they do not establish causation.";
}
function billingAssistantAnswer(){
  return "Only reviewed, saved notes from the selected appointment enter the billing draft. Clinic history, home data, predictions, and other visits are excluded.\n\nVerify the care actually delivered, supported diagnoses, encounter setting, and eligible documented time. Do not infer time from the appointment duration or count planned care as performed.\n\nThe demo assembles notes without AI. It does not assign codes, determine reimbursement, or submit a claim. A connected AI draft would still need source review and qualified coding/payer review.";
}
function assistantQuestions(c){
  const flagged=c.observations.filter(x=>x.flagged);
  return `Possible review questions for ${c.p.name}:

${flagged.length?"• Are the configured ranges appropriate for "+flagged.map(x=>x.def.label.toLowerCase()).join(", ")+"?":"• Are the chosen measures and review ranges appropriate to the care plan?"}
• Were readings obtained under comparable conditions?
• Were symptoms present around the recorded changes?
• Do missing days reflect device issues, reporting burden, or another reason?
• Have routine, sleep, activity, illness, or prescribed medication use changed?
• What matters most to the patient for this visit?

I do not have patient/caregiver messages or verified symptom narratives in this assistant. These are questions to investigate, not conclusions.`;
}
function assistantReply(text,kind,id,c){
  if(kind==="summary")return assistantSummary(c);
  if(kind==="questions")return assistantQuestions(c);
  if(kind==="forecast")return forecastAssistantAnswer();
  if(kind==="billing")return billingAssistantAnswer();
  if(kind==="metric"){
    const x=c.observations.find(x=>x.id===id);
    return x?assistantMetric(x,c):assistantSummary(c);
  }
  const q=text.toLowerCase();
  if(/diagnos|prescrib|treat|dosage|\bdose\b|emergency|urgent|should i/.test(q)){
    return "This offline assistant cannot diagnose, assess urgency, or recommend treatment or medication changes. Use verified clinical information and your established clinical workflow.\n\nI can summarize recorded data and suggest questions to investigate.";
  }
  if(/message|caretaker|caregiver|parent|consent/.test(q)){
    return "Patient/caregiver messages are not connected here. I cannot summarize conversations I have not received.\n\nProduction messaging must enforce authorized participants, patient consent, proxy-access rules, and audit records. Parental access should not silently continue or expand when consent or legal authority changes.";
  }
  if(/bill|claim|coding|reimburse/.test(q))return billingAssistantAnswer();
  if(/forecast|predict|correlat|projection/.test(q))return forecastAssistantAnswer();
  if(/summar|overview/.test(q))return assistantSummary(c);
  if(/question|discuss|ask patient/.test(q))return assistantQuestions(c);
  if(/before|since visit|comparison/.test(q)){
    return `${c.p.name} — fixed 28-day comparison around the recorded last visit:\n\n`+
      comparisonRows().map(r=>`• ${r[0]}: before ${r[1]}; since visit ${r[2]}.`).join("\n")+
      "\n\nVisit day excluded. Different reporting coverage can affect apparent changes. This is descriptive, not a deterioration assessment.";
  }
  const aliases={
    bmi:/\bbmi\b|body mass/,bp:/blood pressure|systolic|diastolic|\bbp\b/,
    pulse:/pulse|heart rate|\bbpm\b/,spo2:/oxygen|spo2|saturation/,
    control:/a1c|hba1c|control test|hit.?6/,test:/midas|egfr|clinic fev/,
    symptoms:/symptom|headache days/,rescue:/rescue/,fev1:/fev1|spirom/,
    medication:/medication|adherence/,severity:/severity|pain/,
    acute:/acute/,function:/activity|function|limited/,
    glucose:/glucose|blood sugar/,range:/time in range/,
    lowEvents:/low.glucose|hypoglyc/,coverage:/coverage|missing|reporting/,
    sleep:/sleep/,stress:/stress/
  };
  const x=c.observations.find(x=>aliases[x.id]?.test(q)||q.includes(x.def.label.toLowerCase()));
  if(x)return assistantMetric(x,c);
  if(/range|flag|unusual|odd|change|trend|why/.test(q)){
    const item=c.observations.find(x=>x.flagged)||c.observations.find(x=>x.shifted)||c.observations[0];
    if(item)return assistantMetric(item,c);
  }
  return "This is a rule-based preview, not a connected language model. Try “Summarize,” ask about a displayed metric, request the before/after comparison, or choose a suggested question.";
}
function sendAssistant(text,kind="free",id=null){
  const c=assistantContext();if(!c||!text.trim())return;
  const clean=text.trim().slice(0,1500);
  if(!assistantThreads[c.p.id])assistantThreads[c.p.id]=[];
  const messages=[
    {role:"user",text:clean},
    {role:"assistant",text:assistantReply(clean,kind,id,c)}
  ];
  assistantThreads[c.p.id].push(...messages);assistantDrafts[c.p.id]="";
  $("assistant-input").value="";
  messages.forEach(m=>$("assistant-messages").append(messageNode(m.role,m.text)));
  assistantRenderedKey=JSON.stringify([c.p.id,c.scope,c.section,c.focused,c.observations.map(x=>[x.id,x.flagged]),config().period,state.g.assistantCues,assistantThreads[c.p.id].length]);
  $("assistant-clear").disabled=false;
  $("assistant-messages").scrollTop=$("assistant-messages").scrollHeight;$("assistant-input").focus();
}
$("assistant-toggle").onclick=()=>setAssistantOpen(!assistantOpen);
$("assistant-close").onclick=()=>setAssistantOpen(false);
$("assistant-form").onsubmit=e=>{e.preventDefault();sendAssistant($("assistant-input").value)};
$("assistant-input").oninput=()=>{
  const c=assistantContext();if(c)assistantDrafts[c.p.id]=$("assistant-input").value;
};
$("assistant-input").onkeydown=e=>{
  if(e.key==="Enter"&&!e.shiftKey&&!e.isComposing){e.preventDefault();sendAssistant(e.target.value)}
};
$("assistant-clear").onclick=()=>{
  const c=assistantContext();if(!c)return;
  assistantThreads[c.p.id]=[];assistantDrafts[c.p.id]="";assistantRenderedKey="";updateAssistant();$("assistant-input").focus();
};
document.addEventListener("keydown",e=>{
  if(e.key==="Escape"&&assistantOpen&&!$("modal").open)setAssistantOpen(false);
});

/* ---------- Routing and event handling ---------- */
function render(){
  if(!state.provider)return;
  stopDictation(true);applyAppearance();$("status").textContent="";
  $("chart-tab").hidden=!state.patient;
  document.querySelectorAll("nav [data-page]").forEach(b=>{
    if(b.dataset.page===state.page)b.setAttribute("aria-current","page");
    else b.removeAttribute("aria-current");
  });
  $("page").innerHTML=state.page==="home"?homeHTML():
    state.page==="calendar"?calendarHTML():
    state.page==="settings"?settingsHTML():
    chartHeader()+(state.tab==="overview"?overviewHTML():state.tab==="appointment"?appointmentHTML():state.tab==="analytics"?analyticsHTML():billingHTML());
  updateAssistant();
}
function navigate(page){
  if(!state.provider||state.busy)return;
  if(page==="chart"&&!state.patient)return;
  stopDictation(true);state.page=page;assistantFocus=null;
  if(page==="settings")state.settingsTab="dashboard";
  render();window.scrollTo(0,0);
}
function openPatient(id,visit=null){
  if(!state.provider.patients.includes(id))return;
  stopDictation(true);state.patient=id;state.appointment=visit;
  state.page="chart";state.tab=visit?"appointment":"overview";
  state.sourceOffset=0;state.pattern="";assistantFocus=null;
  $("modal").close();render();window.scrollTo(0,0);
}
function exportCSV(){
  const rows=[
    ["date_utc","patient_id","response","symptoms","severity","sleep_hours","stress","activity_limited","rescue_uses","acute_medication","low_glucose_events","scheduled_doses","taken","not_taken","unknown","device_records","origin"],
    ...selectedDays().map(d=>[
      d.date,state.patient,Boolean(d.response),d.response?.symptoms??"unknown",d.response?.severity??"",
      d.response?.sleepHours??"",d.response?.stress??"",d.response?.activityLimited??"unknown",
      d.response?.rescueUses??"",d.response?.acuteMedication??"",d.response?.lowGlucoseEvents??"",
      d.doses.length,d.doses.filter(v=>v.status==="taken").length,d.doses.filter(v=>v.status==="not_taken").length,
      d.doses.filter(v=>v.status==="no_report").length,
      d.devices.map(v=>`${v.type}:${v.value} ${v.unit} [${v.quality}]`).join("; "),"fictional_home_monitoring"
    ])
  ];
  download(rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(",")).join("\r\n"),
    "text/csv;charset=utf-8","SMART-Clinic-monitoring-"+state.patient+".csv");
  notify("Monitoring data exported. Clinic records and notes excluded.");
}
function handleClick(event){
  if(!state.provider||state.busy)return;
  const b=event.target.closest("button");if(!b||b.disabled)return;
  if(b.dataset.page){navigate(b.dataset.page);return}
  if(b.dataset.patient){openPatient(b.dataset.patient);return}
  if(b.dataset.section){
    stopDictation(true);state.tab=b.dataset.section;state.sourceOffset=0;assistantFocus=null;render();return;
  }
  if(b.dataset.settingsTab){state.settingsTab=b.dataset.settingsTab;render();return}
  if(b.dataset.detail){openDetail(b.dataset.scope,b.dataset.detail);return}
  if(b.dataset.event){
    const a=state.appointments.find(a=>a.id===b.dataset.event);
    showModal("Appointment",`<h2>${esc(patients[a.patient].name)}</h2><p>${dateLabel(a.date)} · ${a.time} · ${a.duration} minutes</p><p>${esc(a.reason)}</p><button class="primary" data-open-visit="${a.id}">Open appointment chart</button>`);
    return;
  }
  if(b.dataset.openVisit){
    const a=state.appointments.find(a=>a.id===b.dataset.openVisit);openPatient(a.patient,a.id);return;
  }
  if(b.dataset.day){
    const d=patient().days.find(d=>d.date===b.dataset.day);
    if(d)showModal("Source record · "+d.date,`<pre>${esc(JSON.stringify(d,null,2))}</pre>`);
    return;
  }
  switch(b.dataset.action){
    case"ask":assistantFocus=null;setAssistantOpen(true);break;
    case"ask-detail":{
      const focus=state.detail?{scope:state.detail.scope,id:state.detail.id}:null;
      $("modal").close();assistantFocus=focus;setAssistantOpen(true);break;
    }
    case"view-forecasts":$("modal").close();state.tab="analytics";assistantFocus=null;render();break;
    case"patient-settings":patientSettings();break;
    case"reset-patient":
      if(confirm("Reset all display and review-range overrides for this patient?")){
        delete state.p[state.patient];const saved=saveSettings();$("modal").close();render();notify(saved?"Provider defaults restored.":"Restored for this session.");
      }break;
    case"calendar-shift":state.calendarDate=shift(state.calendarDate,Number(b.dataset.value)*(state.calendarMode==="week"?7:1));render();break;
    case"calendar-today":state.calendarDate=END;render();break;
    case"calendar-mode":state.calendarMode=b.dataset.value;render();break;
    case"source-prev":state.sourceOffset=Math.max(0,state.sourceOffset-30);render();$("source-details").open=true;break;
    case"source-next":state.sourceOffset+=30;render();$("source-details").open=true;break;
    case"export-csv":exportCSV();break;
    case"comparison-evidence":{
      const c=comparison();
      showModal("Comparison source evidence",`<h3>Before · ${c.beforeStart}–${c.beforeEnd}</h3><div class="table-wrap">${sourceTable(c.a.days.slice().reverse())}</div><h3 style="margin-top:20px">After · ${c.afterStart}–${END}</h3><div class="table-wrap">${sourceTable(c.b.days.slice().reverse())}</div>`);
      break;
    }
    case"speech-start":startDictation();break;
    case"speech-stop":stopDictation(false);break;
    case"save-note":saveNote();break;
    case"billing-demo":prepareBillingDemo();break;
    case"billing-ai":billingAI();break;
    case"billing-export":exportBilling();break;
    case"register-device":deviceAction(true);break;
    case"forget-device":notify(remove(deviceKey(state.provider.id))?"Registration forgotten. A passkey may remain in your device manager.":"Storage unavailable.");break;
    case"specialty-preset":
      state.g.metrics=[...state.provider.metrics];state.g.ovMetrics=[...ovKeys];
      saveSettings();render();notify("Specialty card defaults restored. Patient overrides retained.");break;
    case"connection":
      showModal("EHR and consent integration",`
        <div class="notice">No external system is contacted by this prototype.</div>
        <h3 style="margin-top:18px">Production requirements</h3>
        <ul>
          <li>Approved OAuth / SMART on FHIR application and server-side token handling.</li>
          <li>Authenticated clinicians, patient matching, role-based authorization, and audit records.</li>
          <li>Separate patient and caregiver identities with explicit proxy permissions.</li>
          <li>Age-, jurisdiction-, and consent-aware transitions; no automatic continued parental access.</li>
          <li>Appropriate privacy agreements and data minimization for any AI provider.</li>
        </ul>`);
      break;
  }
}
$("workspace").addEventListener("click",handleClick);
$("modal").addEventListener("click",handleClick);

function handleChange(event){
  if(!state.provider||state.busy)return;
  const t=event.target;
  if(t.dataset.visual){
    const scope=t.dataset.scope,id=t.dataset.visual;
    (scope==="clinic"?state.g.ovVisuals:state.g.visuals)[id]=t.value;
    const detail=state.detail?{...state.detail}:null,saved=saveSettings();
    render();
    if(detail&&$("modal").open)openDetail(detail.scope,detail.id,detail.average);
    notify(saved?"Graph preference saved for all your patients.":"Graph changed for this session.");
    return;
  }
  if(t.dataset.pref){
    const k=t.dataset.pref;
    state.g[k]=t.type==="checkbox"?t.checked:k==="text"?Number(t.value):t.value;
    const saved=saveSettings();render();if(!saved)notify("Updated for this session; storage unavailable.");return;
  }
  switch(t.id){
    case"chart-patient":openPatient(t.value);break;
    case"selected-visit":stopDictation(true);state.appointment=t.value;assistantFocus=null;render();break;
    case"review-period":
      state.p[state.patient]={...(state.p[state.patient]||{}),period:t.value};
      state.sourceOffset=0;assistantFocus=null;saveSettings();render();break;
    case"support-metric":
      state.p[state.patient]={...(state.p[state.patient]||{}),trendMetric:t.value};
      saveSettings();render();break;
    case"calendar-date":if(/^\d{4}-\d{2}-\d{2}$/.test(t.value)){state.calendarDate=t.value;render()}break;
    case"analytics-pattern":state.pattern=t.value;render();break;
    case"review-note":state.reviewed[draftKey()]=t.checked;break;
    case"detail-average":if(state.detail)openDetail(state.detail.scope,state.detail.id,t.checked);break;
    case"billing-setting":{
      const s=billingSession();s.setting=t.value;s.draft=null;s.reviewed=false;
      $("billing-draft").innerHTML='<p class="empty">Details changed. Prepare a new draft.</p>';break;
    }
    case"billing-reviewed":{
      const s=billingSession();s.reviewed=t.checked;
      $("billing-draft").querySelector('[data-action="billing-export"]').disabled=!t.checked;break;
    }
  }
}
$("workspace").addEventListener("change",handleChange);
$("modal").addEventListener("change",handleChange);

function handleInput(event){
  if(!state.provider)return;
  const t=event.target;
  if(t.id==="note-text"){
    state.drafts[draftKey()]=t.value;state.reviewed[draftKey()]=false;$("review-note").checked=false;
  }else if(t.id==="detail-slider"){inspectReading(Number(t.value))}
  else if(t.id==="billing-minutes"){
    const s=billingSession();s.minutes=t.value;s.draft=null;s.reviewed=false;
    $("billing-draft").innerHTML='<p class="empty">Time changed. Prepare a new draft.</p>';
  }
}
$("workspace").addEventListener("input",handleInput);
$("modal").addEventListener("input",handleInput);

function handleSubmit(event){
  const form=event.target;
  if(!["global-display-form","patient-display-form","global-ranges-form","patient-ranges-form"].includes(form.id))return;
  event.preventDefault();
  try{
    const isPatient=form.id.startsWith("patient"),isRanges=form.id.includes("ranges");
    const value=isRanges?{targets:readRanges(form)}:readDisplay(form);
    if(isPatient)state.p[state.patient]={...(state.p[state.patient]||{}),...value};
    else state.g={...state.g,...value};
    const saved=saveSettings();
    if(isPatient)$("modal").close();
    render();notify(saved?"Settings saved.":"Updated for this session; browser storage unavailable.");
  }catch(e){
    if($("modal").open&&$("modal-status"))$("modal-status").textContent=e.message;
    else notify(e.message);
  }
}
$("workspace").addEventListener("submit",handleSubmit);
$("modal").addEventListener("submit",handleSubmit);

window.addEventListener("pagehide",()=>{stopDictation(true);clearBilling()});
document.documentElement.dataset.theme="light";
document.documentElement.style.fontSize="14px";
})();
</script>
