function validateBilling(){
  const s=billingSession(),n=s.minutes===""?null:Number(s.minutes);
  if(n!==null&&(!Number.isInteger(n)||n<1||n>1440))throw new Error("Documented minutes must be a whole number from 1 to 1440, or blank.");
  if(!notesForVisit().length)throw new Error("Save reviewed visit notes first.");
}
function prepareBillingDemo(){
  try{
    validateBilling();const s=billingSession(),payload=billingPayload();
    s.reviewed=false;s.draft={
      mode:"Source-note assembly · Not AI",createdAt:new Date().toISOString(),payload,
      findings:payload.notes.map(n=>({category:"Reviewed note",statement:n.text,evidence:[{noteId:n.id,quote:n.text}]})),
      questions:billingQuestions()
    };
    render();notify("Demo draft prepared. Review before export.");
  }catch(e){notify(e.message)}
}
function validateAI(result,payload){
  if(!result||!Array.isArray(result.findings)||result.findings.length>40)throw new Error("Invalid AI response.");
  const sources=new Map(payload.notes.map(n=>[n.id,n.text]));
  const findings=result.findings.map(f=>{
    if(typeof f.category!=="string"||typeof f.statement!=="string"||!f.statement.trim()||f.statement.length>5000||
      !Array.isArray(f.evidence)||!f.evidence.length||f.evidence.length>20)throw new Error("Missing or invalid source evidence.");
    const evidence=f.evidence.map(r=>{
      const text=sources.get(r.noteId);
      if(typeof text!=="string"||typeof r.quote!=="string"||!r.quote.trim()||!text.includes(r.quote))throw new Error("Evidence does not match the source note.");
      return {noteId:r.noteId,quote:r.quote};
    });
    return {category:f.category.slice(0,120),statement:f.statement,evidence};
  });
  const questions=Array.isArray(result.questions)?result.questions.filter(q=>typeof q==="string").slice(0,20).map(q=>q.slice(0,1500)):[];
  return {findings,questions};
}
async function billingAI(){
  if(!BILLING_AI_ENDPOINT)return;
  try{validateBilling()}catch(e){notify(e.message);return}
  if(location.protocol==="file:"){notify("AI requires a hosted application and protected backend.");return}
  if(!confirm("Send these fictional appointment notes to the configured backend?"))return;
  const id=billingKey(),s=billingSession(),payload=billingPayload(),signature=s.signature;
  const controller=new AbortController();
  s.draft=null;s.reviewed=false;billingRequests.set(id,controller);render();
  let message="";
  try{
    const response=await fetch(BILLING_AI_ENDPOINT,{
      method:"POST",credentials:"same-origin",headers:{"Content-Type":"application/json"},
      body:JSON.stringify(payload),signal:controller.signal
    });
    if(!response.ok)throw new Error("AI service unavailable.");
    const result=validateAI(await response.json(),payload),current=billingSessions.get(id);
    if(!current||current.signature!==signature||controller.signal.aborted||
      current.setting!==(payload.encounter.setting||"")||
      (current.minutes===""?null:Number(current.minutes))!==payload.encounter.providerEnteredMinutes)return;
    current.draft={
      mode:"AI draft · Evidence and clinical review required",createdAt:new Date().toISOString(),payload,
      findings:result.findings,questions:[...result.questions,...billingQuestions()]
    };
    current.reviewed=false;
    message="Draft ready. Exact quote matching does not prove the summary is clinically or semantically supported.";
  }catch(e){if(e.name!=="AbortError")message=e.message}
  finally{
    billingRequests.delete(id);
    if(state.provider&&state.patient&&billingKey()===id&&state.page==="chart"&&state.tab==="billing"){render();notify(message)}
  }
}
function exportBilling(){
  const s=billingSession();if(!s.draft||!s.reviewed){notify("Prepare and review the current draft.");return}
  download(JSON.stringify({
    ...s.draft,reviewedBy:state.provider.name,reviewedAt:new Date().toISOString(),
    status:"reviewed-documentation-draft",billingCodesAssigned:false,claimSubmitted:false,
    disclaimer:"Synthetic demo. Not an invoice, claim, coding decision, or reimbursement guarantee."
  },null,2),"application/json;charset=utf-8","SMART-Clinic-billing-"+state.patient+".json");
  notify("Documentation exported. No claim submitted.");
}

