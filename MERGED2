function assistantContext(){
  if(!state.provider||!state.patient||state.page!=="chart"||!state.provider.patients.includes(state.patient))return null;
  const p=patient(),scope=assistantFocus?.scope||(state.tab==="overview"?"clinic":"home");
  const ids=assistantFocus?[assistantFocus.id]:visibleIds(scope);
  const ds=scope==="home"?selectedDays():null;
  const observations=ids.map(id=>{
    const def=scope==="clinic"?ovDefinition(id):{...metrics[id],label:metricLabel(id)};
    const rows=scope==="clinic"?overviewSeries(id):dailySeries(id,ds);
    const latest=latestRow(rows),t=targetFor(scope,id);
    const recent=scope==="home"?dailySeries(id,p.days.slice(-7)).map(r=>r.value).filter(finite):[];
    const baseline=scope==="home"?dailySeries(id,p.days.slice(-35,-7)).map(r=>r.value).filter(finite):[];
    const recentMean=mean(recent),baselineMean=mean(baseline);
    const spread=baseline.length?Math.sqrt(mean(baseline.map(v=>(v-baselineMean)**2))):null;
    const shifted=recent.length>=5&&baseline.length>=14&&
      Math.abs(recentMean-baselineMean)>Math.max(2*spread,Math.abs(baselineMean)*.15,.3);
    return {id,def,rows,latest,target:t,flagged:targetFlag(latest?.value,t),
      recent,baseline,recentMean,baselineMean,shifted};
  });
  return {p,scope,observations,section:state.tab,focused:Boolean(assistantFocus),ds};
}
