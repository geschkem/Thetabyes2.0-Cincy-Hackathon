/* ---------- Dictation ---------- */
function stopDictation(abort=false){
  if(!recognition)return;
  const r=recognition;
  if(abort){
    recognition=null;r.onresult=null;r.onend=null;r.onerror=null;
    try{r.abort()}catch{}
  }else{try{r.stop()}catch{}}
  if($("speech-status"))$("speech-status").textContent="Dictation stopped. Review finalized text.";
}
function startDictation(){
  const API=window.SpeechRecognition||window.webkitSpeechRecognition;
  if(!API){notify("Browser dictation unavailable. Type instead.");return}
  if(recognition)return;
  if(!confirm("Fictional information only. Browser recognition may send audio to its vendor. Start dictation?"))return;
  const owner=state.provider.id,pid=state.patient,dk=draftKey(),r=new API();
  recognition=r;r.lang="en-US";r.continuous=true;r.interimResults=true;
  const valid=()=>recognition===r&&state.provider?.id===owner&&state.patient===pid&&state.page==="chart"&&state.tab==="appointment"&&draftKey()===dk;
  r.onresult=e=>{
    if(!valid())return;let interim="";
    for(let i=e.resultIndex;i<e.results.length;i++){
      const text=e.results[i][0].transcript;
      if(e.results[i].isFinal){
        const old=state.drafts[dk]||"";
        state.drafts[dk]=(old+(old?" ":"")+text).slice(0,5000);
        state.reviewed[dk]=false;$("review-note").checked=false;$("note-text").value=state.drafts[dk];
      }else interim+=text;
    }
    $("speech-status").textContent=interim?"Listening… "+interim:"Listening…";
  };
  r.onerror=e=>{
    if(recognition!==r)return;
    recognition=null;r.onresult=null;try{r.abort()}catch{}
    if($("speech-status"))$("speech-status").textContent="Stopped: "+e.error+". Check permissions or type instead.";
  };
  r.onend=()=>{
    if(recognition===r){recognition=null;if($("speech-status"))$("speech-status").textContent="Stopped. Review before saving."}
  };
  try{r.start();$("speech-status").textContent="Listening…"}catch{recognition=null;notify("Could not start dictation.")}
}
function saveNote(){
  if(recognition){notify("Stop dictation and review first.");return}
  const text=$("note-text").value.trim(),dk=draftKey();
  if(!text){notify("Enter a note first.");return}
  if(!state.reviewed[dk]){notify("Confirm the note is reviewed.");return}
  state.notes.push({
    id:"note-"+(++noteSequence),patient:state.patient,appointment:currentAppointment()?.id||null,
    author:state.provider.name,time:new Date().toISOString(),text
  });
  state.drafts[dk]="";state.reviewed[dk]=false;
  $("note-text").value="";$("review-note").checked=false;$("notes").innerHTML=notesHTML();
  billingSession();notify("Reviewed note saved to this appointment.");
}

