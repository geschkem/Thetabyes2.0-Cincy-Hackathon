/* ---------- Forecasts and correlations ---------- */
function weeklyBurden(records){
  const usable=records.slice(-(Math.floor(records.length/7)*7));
  if(records.length<7)return [];
  const weeks=[];
  for(let i=0;i+7<=usable.length;i+=7){
    const chunk=usable.slice(i,i+7),valid=chunk.filter(r=>finite(r.value)),positive=valid.filter(r=>r.value>0).length;
    weeks.push({start:chunk[0].date,date:chunk.at(-1).date,n:valid.length,positive,value:valid.length>=5?positive/valid.length*7:null});
  }
  return weeks;
}
function forecastPoint(history){
  if(history.length<4)return null;
  const recent=history.slice(-4);
  if(recent.some(w=>!finite(w.value)))return null;
  const recentMean=mean(recent.map(w=>w.value)),prior=history.slice(-8,-4);
  const priorMean=prior.length===4&&prior.every(w=>finite(w.value))?mean(prior.map(w=>w.value)):recentMean;
  return Math.max(0,Math.min(7,recentMean+Math.max(-.8,Math.min(.8,(recentMean-priorMean)*.35))));
}
function forecastResult(weeks){
  const prediction=forecastPoint(weeks);
  if(prediction===null)return {ok:false};
  const errors=[],baseline=[];
  for(let i=4;i<weeks.length;i++){
    const pred=forecastPoint(weeks.slice(0,i)),actual=weeks[i].value,prev=weeks[i-1].value;
    if(finite(pred)&&finite(actual)&&finite(prev)){
      errors.push(Math.abs(actual-pred));baseline.push(Math.abs(actual-prev));
    }
  }
  const mae=mean(errors),spread=finite(mae)?Math.max(1,Math.min(3,mae*1.5)):null;
  return {ok:true,prediction,mae,baseline:mean(baseline),folds:errors.length,
    low:spread===null?null:Math.max(0,prediction-spread),
    high:spread===null?null:Math.min(7,prediction+spread),latest:weeks.at(-1)};
}
function forecastSVG(weeks,r){
  const W=850,H=270,L=45,R=55,T=20,B=40,w=W-L-R,h=H-T-B;
  const X=i=>L+i/Math.max(1,weeks.length)*w,Y=v=>T+h-v/7*h;
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Reporting-adjusted weekly burden and illustrative next-week extrapolation">`;
  for(let i=0;i<=7;i++)s+=`<line x1="${L}" x2="${W-R}" y1="${Y(i)}" y2="${Y(i)}" stroke="var(--line)"/><text x="${L-9}" y="${Y(i)+4}" text-anchor="end" fill="var(--muted)" font-size="10">${i}</text>`;
  weeks.forEach((v,i)=>{
    if(!finite(v.value))return;
    if(i&&finite(weeks[i-1].value))s+=`<line x1="${X(i-1)}" y1="${Y(weeks[i-1].value)}" x2="${X(i)}" y2="${Y(v.value)}" stroke="var(--accent)" stroke-width="2"/>`;
    s+=`<circle cx="${X(i)}" cy="${Y(v.value)}" r="3" fill="var(--accent)"><title>${v.date}: ${v.positive}/${v.n} positive/reporting days; adjusted ${v.value.toFixed(1)}</title></circle>`;
    if(i%Math.max(1,Math.ceil(weeks.length/5))===0)s+=`<text x="${X(i)}" y="${H-10}" text-anchor="middle" font-size="9" fill="var(--muted)">${v.date}</text>`;
  });
  const fx=X(weeks.length);
  if(finite(r.low))s+=`<rect x="${fx-10}" y="${Y(r.high)}" width="20" height="${Y(r.low)-Y(r.high)}" fill="var(--warn)" opacity=".22"/>`;
  s+=`<line x1="${X(weeks.length-1)}" y1="${Y(r.latest.value)}" x2="${fx}" y2="${Y(r.prediction)}" stroke="var(--warn)" stroke-width="2" stroke-dasharray="6 4"/>
    <circle cx="${fx}" cy="${Y(r.prediction)}" r="5" fill="var(--warn)"/>
    <text x="${fx}" y="${H-10}" text-anchor="middle" fill="var(--muted)" font-size="10">Next week</text></svg>`;
  return s;
}
function pearson(xs,ys){
  const mx=mean(xs),my=mean(ys),dx=xs.map(x=>x-mx),dy=ys.map(y=>y-my);
  const den=Math.sqrt(dx.reduce((s,x)=>s+x*x,0)*dy.reduce((s,y)=>s+y*y,0));
  return den?dx.reduce((s,x,i)=>s+x*dy[i],0)/den:null;
}
function patterns(){
  const pairs=state.provider.type==="asthma"?[["sleep","symptoms"],["stress","symptoms"],["sleep","rescue"]]:
    state.provider.type==="migraine"?[["sleep","severity"],["stress","severity"],["sleep","function"]]:
    [["sleep","glucose"],["stress","glucose"],["sleep","lowEvents"]];
  return pairs.map(([a,b])=>{
    const right=new Map(dailySeries(b).map(r=>[r.date,r.value]));
    const values=dailySeries(a).map(r=>({date:r.date,x:r.value,y:right.get(r.date)})).filter(r=>finite(r.x)&&finite(r.y));
    const r=values.length>=12?pearson(values.map(v=>v.x),values.map(v=>v.y)):null;
    return {key:a+":"+b,a,b,values,r};
  });
}
function scatterSVG(p){
  const rows=p.values,W=700,H=270,L=65,R=25,T=20,B=48,w=W-L-R,h=H-T-B;
  let xmin=Math.min(...rows.map(r=>r.x)),xmax=Math.max(...rows.map(r=>r.x));
  let ymin=Math.min(...rows.map(r=>r.y)),ymax=Math.max(...rows.map(r=>r.y));
  if(xmin===xmax)xmax++;if(ymin===ymax)ymax++;
  const X=v=>L+(v-xmin)/(xmax-xmin)*w,Y=v=>T+h-(v-ymin)/(ymax-ymin)*h;
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(metricLabel(p.a)+" versus "+metricLabel(p.b))}">`;
  for(let i=0;i<=4;i++){
    const xv=xmin+(xmax-xmin)*i/4,yv=ymin+(ymax-ymin)*i/4;
    s+=`<line x1="${L}" x2="${W-R}" y1="${Y(yv)}" y2="${Y(yv)}" stroke="var(--line)"/>
      <text x="${L-8}" y="${Y(yv)+4}" text-anchor="end" fill="var(--muted)" font-size="10">${yv.toFixed(1)}</text>
      <text x="${X(xv)}" y="${T+h+17}" text-anchor="middle" fill="var(--muted)" font-size="10">${xv.toFixed(1)}</text>`;
  }
  rows.forEach(r=>s+=`<circle cx="${X(r.x)}" cy="${Y(r.y)}" r="3" fill="var(--accent)" opacity=".4"><title>${r.date}: ${r.x}, ${r.y}</title></circle>`);
  return s+`<text x="${W/2}" y="${H-5}" text-anchor="middle" fill="var(--muted)" font-size="11">${esc(metricLabel(p.a)+" ("+metrics[p.a].unit+")")}</text></svg>`;
}
function analyticsHTML(){
