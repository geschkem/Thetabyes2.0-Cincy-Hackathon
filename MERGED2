<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SMART@Clinic — Integrated Workspace</title>

<style>
:root{
  --accent:#087e88;
  --bg:#f7fafb;
  --card:#ffffff;
  --ink:#132c3b;
  --muted:#526c79;
  --soft:#eaf8f6;
  --line:#d4e9e9;
  --good:#237449;
  --bad:#b3261e;
  --warn:#986000;
}
:root[data-theme="dark"]{
  --bg:#0f1b20;
  --card:#172a31;
  --ink:#e8f1f3;
  --muted:#adc1c9;
  --soft:#203942;
  --line:#38535c;
  --good:#72d7a2;
  --bad:#ffaaa2;
  --warn:#edbd73;
}
@media(prefers-color-scheme:dark){
  :root[data-theme="system"]{
    --bg:#0f1b20;
    --card:#172a31;
    --ink:#e8f1f3;
    --muted:#adc1c9;
    --soft:#203942;
    --line:#38535c;
    --good:#72d7a2;
    --bad:#ffaaa2;
    --warn:#edbd73;
  }
}
:root[data-contrast="true"]{
  --line:var(--ink);
  --muted:var(--ink);
}
:root[data-palette="accessible"]{
  --good:#268bc2;
  --bad:#d77822;
  --warn:#a77bc7;
}
:root[data-font="readable"] body{
  font-family:Verdana,Arial,sans-serif;
  letter-spacing:.035em;
  word-spacing:.08em;
  line-height:1.75;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{
  margin:0;
  background:var(--bg);
  color:var(--ink);
  font-family:"Avenir Next",Avenir,"Trebuchet MS",Arial,sans-serif;
  line-height:1.55;
}
button,input,select,textarea{font:inherit;color:inherit}
button,input,select,textarea{
  border:1px solid var(--line);
  border-radius:6px;
  padding:9px 12px;
  background:var(--card);
}
button{cursor:pointer;font-weight:600}
button:hover{background:var(--soft)}
button:disabled{opacity:.48;cursor:not-allowed}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
input[type=checkbox]{width:18px;height:18px;accent-color:var(--accent)}
input[type=color]{width:60px;height:42px;padding:4px}
textarea{width:100%;min-height:125px;resize:vertical}
label{font-size:.85rem}
h1,h2,h3,p{margin-top:0}
h1{font-size:1.95rem;line-height:1.2;letter-spacing:-.6px;margin-bottom:10px}
h2{font-size:1.16rem;margin-bottom:12px}
h3{font-size:1rem;margin-bottom:9px}
p{margin-bottom:12px}
.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.primary:hover{background:var(--accent);filter:brightness(.94)}
.link{
  border:0;background:transparent;padding:0;
  color:var(--accent);text-decoration:underline;text-underline-offset:3px;
}
.small,.note{font-size:.8rem}
.muted,.note{color:var(--muted)}
.good{color:var(--good)}
.bad{color:var(--bad)}
.warn{color:var(--warn)}
.flex{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.between{justify-content:space-between}
.spacer{flex:1}
.stack{display:grid;gap:18px}
.brand{font-size:1.95rem;font-weight:800;letter-spacing:-1px;line-height:1.2}
.brand span{color:var(--accent)}
.masthead{
  background:var(--card);
  border-bottom:2px solid var(--accent);
  padding:20px max(24px,calc((100vw - 1220px)/2));
  display:flex;align-items:center;justify-content:space-between;gap:20px;
}
.logo-area{width:255px;max-width:46vw;text-align:right}
.logo-area img{
  display:block;width:100%;aspect-ratio:3/1;object-fit:cover;
  background:#fff;border-radius:6px;
}
.logo-fallback{font-size:1.15rem;font-weight:750}
.logo-action{font-size:.7rem;margin-top:5px}
.provider-header{
  max-width:1220px;margin:auto;padding:17px 24px;
  display:flex;align-items:center;justify-content:space-between;gap:15px;
}
nav{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--line)}
.nav-inner{max-width:1220px;margin:auto;padding:0 24px;display:flex;gap:8px;overflow:auto}
nav button{
  border:0;border-bottom:2px solid transparent;border-radius:0;
  white-space:nowrap;padding:14px;color:var(--muted);
}
nav button[aria-current=page]{
  color:var(--accent);border-bottom-color:var(--accent);background:var(--soft);
}
main{max-width:1220px;margin:auto;padding:28px 24px 120px}
.login{
  width:min(470px,calc(100% - 32px));margin:38px auto;padding:30px;
  background:var(--card);border:1px solid var(--line);
  border-top:3px solid var(--accent);border-radius:9px;
}
.login input{width:100%}
.field{margin:17px 0}
.field label{display:block;font-weight:700;margin-bottom:6px}
.login details{margin-top:22px;border-top:1px solid var(--line);padding-top:16px}
.account{padding:10px 0;border-bottom:1px solid var(--line);font-size:.82rem}
.error{color:var(--bad);min-height:20px;font-size:.85rem}
.notice{
  background:var(--soft);border:1px solid var(--line);
  padding:12px 14px;border-radius:6px;font-size:.82rem;
}
.panel,.card{
  padding:21px;background:var(--card);
  border:1px solid var(--line);border-radius:9px;min-width:0;
}
.panel{margin-bottom:18px}
.home-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;align-items:start}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:start}
.welcome{padding:6px 0 24px}
.date{font-size:.78rem;color:var(--accent);letter-spacing:.8px;font-weight:700;margin-bottom:12px}
.patient-row{
  width:100%;display:flex;align-items:center;gap:12px;flex-wrap:wrap;
  text-align:left;padding:15px 0;border:0;border-bottom:1px solid var(--line);border-radius:0;
}
.avatar{
  width:43px;height:43px;display:grid;place-items:center;border-radius:50%;
  color:var(--accent);background:var(--soft);font-weight:750;flex:none;
}
.tabs{
  display:flex;gap:7px;flex-wrap:wrap;border-bottom:1px solid var(--line);
  padding-bottom:12px;margin:20px 0;
}
.tabs button[aria-pressed=true]{background:var(--soft);border-color:var(--accent)}
.cards{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));
  gap:15px;margin:18px 0;
}
.overview-cards{grid-template-columns:repeat(3,minmax(0,1fr))}
.cards.list{grid-template-columns:1fr}
.card{display:flex;flex-direction:column}
.card.flagged{border:2px solid var(--bad)}
.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.card-head h2{font-size:.9rem;margin:0}
.card-head h2 button{text-align:left;font-size:inherit}
.visual-control label{display:block;font-size:.68rem;margin-bottom:3px}
.visual-control select{font-size:.75rem;padding:4px 6px;max-width:125px}
.value{font-size:1.95rem;font-weight:750;letter-spacing:-.6px;color:var(--accent)}
.description{font-size:.8rem;color:var(--muted);margin:7px 0 10px}
.source{margin-top:auto;padding-top:10px;border-top:1px solid var(--line);font-size:.73rem;color:var(--muted)}
.chip{
  display:inline-flex;align-items:center;gap:5px;padding:3px 9px;
  border:1px solid var(--line);border-radius:99px;background:var(--soft);
  font-size:.75rem;font-weight:600;
}
.profile-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;background:var(--soft)}
.profile-strip strong{display:block;font-size:.9rem}
.profile-strip span{font-size:.78rem;color:var(--muted)}
dl{display:grid;grid-template-columns:105px 1fr;gap:10px 14px;margin:0}
dt{font-size:.82rem;font-weight:700;color:var(--muted)}
dd{margin:0;font-size:.9rem}
svg{display:block;width:100%}
.chart-scroll{overflow-x:auto}
.chart-scroll svg{min-width:620px}
.table-wrap{overflow:auto;max-height:480px}
table{border-collapse:collapse;width:100%;font-size:.82rem}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{background:var(--soft);color:var(--muted)}
summary{cursor:pointer;font-size:.85rem}
.note-entry{padding:12px 0;border-top:1px solid var(--line)}
.note-entry p{white-space:pre-wrap;overflow-wrap:anywhere;margin:7px 0 0}
.check-label{display:flex;align-items:center;gap:9px;margin:14px 0;font-size:.85rem}
.toolbar{padding:12px;border:1px solid var(--line);border-radius:6px;display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.calendar-scroll{overflow:auto;border:1px solid var(--line);border-radius:8px;background:var(--card)}
.week{display:grid;grid-template-columns:repeat(7,minmax(140px,1fr));min-width:980px}
.day-column{padding:15px 10px;min-height:270px;border-right:1px solid var(--line)}
.day-column:last-child{border:0}
.day-heading{font-size:.85rem;padding-bottom:11px;margin-bottom:16px;border-bottom:1px solid var(--line)}
.today{background:var(--soft)}
.event{
  width:100%;text-align:left;background:var(--soft);
  border-left:3px solid var(--accent);padding:11px;margin:9px 0;font-size:.82rem;
}
.event strong{display:block;margin:4px 0}
.empty{padding:15px 0;color:var(--muted)}
.setting-row{
  display:flex;align-items:center;justify-content:space-between;gap:12px;
  padding:12px 0;border-bottom:1px solid var(--line);flex-wrap:wrap;
}
.setting-row label{display:flex;align-items:center;gap:9px}
.setting-row select{font-size:.82rem;max-width:165px}
.settings-panel{max-width:900px}
.badge{font-size:.7rem;padding:2px 6px;border:1px solid var(--line);border-radius:4px}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:12px;margin:15px 0}
.stats>div{border:1px solid var(--line);padding:13px;border-radius:6px;background:var(--card)}
.stats strong{display:block;font-size:1.4rem;color:var(--accent)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.78rem;color:var(--muted);margin:10px 0}
.swatch{display:inline-block;width:18px;border-top:3px solid var(--accent);vertical-align:middle;margin-right:6px}
.swatch.forecast{border-color:var(--warn);border-top-style:dashed}
.readout{padding:12px;background:var(--soft);border-radius:6px;font-size:.85rem}
.slider{display:flex;align-items:center;gap:10px;margin:12px 0;font-size:.82rem}
.slider input{flex:1;min-width:100px;accent-color:var(--accent)}
footer{color:var(--muted);font-size:.75rem;border-top:1px solid var(--line);padding-top:15px;margin-top:24px}
dialog{
  width:min(960px,calc(100% - 28px));max-height:calc(100dvh - 40px);
  padding:0;border:1px solid var(--line);border-radius:10px;
  color:var(--ink);background:var(--card);
}
dialog::backdrop{background:#102f3b77}
.dialog-heading{
  padding:17px 22px;background:var(--card);border-bottom:1px solid var(--line);
  position:sticky;top:0;z-index:1;
}
.dialog-heading h2{margin:0}
.dialog-body{padding:22px}
pre{font-size:.78rem;white-space:pre-wrap;overflow-wrap:anywhere}
.billing-finding{padding:13px;margin:10px 0;border:1px solid var(--line);border-radius:6px}
.billing-finding p{white-space:pre-wrap;overflow-wrap:anywhere}
.billing-quote{border-left:3px solid var(--accent);padding:8px 11px;font-size:.82rem;color:var(--muted);white-space:pre-wrap}
.color-preview{width:40px;height:40px;border-radius:9px;background:var(--accent)}
.assistant{
  position:fixed;right:20px;bottom:20px;z-index:100;
  display:flex;flex-direction:column;align-items:flex-end;gap:10px;
}
.assistant-launcher{
  display:flex;align-items:center;gap:9px;padding:13px 18px;border-radius:999px;
  color:#fff;background:var(--accent);border-color:var(--accent);box-shadow:0 6px 24px #0003;
}
.assistant-launcher:hover{background:var(--accent);filter:brightness(.95)}
.assistant-dot{width:9px;height:9px;border-radius:50%;background:#fff}
.assistant-panel{
  width:min(415px,calc(100vw - 32px));
  height:min(660px,calc(100dvh - 105px));
  display:flex;flex-direction:column;overflow:hidden;
  border:1px solid var(--line);border-radius:14px;
  background:var(--card);box-shadow:0 12px 45px #0003;
}
.assistant-header{padding:14px 16px;border-bottom:1px solid var(--line);flex:none}
.assistant-header h2{margin:0;font-size:1rem}
.assistant-close{font-size:1.25rem;padding:2px 10px;border:0}
.assistant-context{font-size:.75rem;color:var(--muted);margin-top:5px}
.assistant-disclaimer{background:var(--soft);color:var(--muted);padding:9px 16px;font-size:.72rem;flex:none}
.assistant-messages{
  flex:1;min-height:70px;overflow:auto;display:flex;flex-direction:column;
  gap:12px;padding:15px;overscroll-behavior:contain;
}
.assistant-message{
  max-width:95%;padding:11px 13px;border:1px solid var(--line);
  border-radius:10px;background:var(--soft);font-size:.84rem;overflow-wrap:anywhere;
}
.assistant-message.user{align-self:flex-end;background:var(--card)}
.assistant-message strong{display:block;font-size:.72rem;color:var(--muted);margin-bottom:5px}
.assistant-message p{margin:0;white-space:pre-wrap}
.assistant-prompts{display:grid;gap:6px;padding:0 15px 10px;flex:none;max-height:135px;overflow:auto}
.assistant-prompts button{font-size:.76rem;padding:7px 10px;text-align:left;font-weight:500}
.assistant-form{padding:10px 15px;border-top:1px solid var(--line);flex:none}
.assistant-form textarea{min-height:55px;height:60px;max-height:100px;font-size:.84rem}
.assistant-form .flex{margin-top:7px}
.assistant-form p{font-size:.71rem;margin:7px 0 0}
@media(max-width:1000px){.overview-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:850px){
  .home-grid,.two-col{grid-template-columns:1fr}
  .profile-strip{grid-template-columns:1fr 1fr}
}
@media(max-width:600px){
  .masthead{padding:17px 16px}
  .brand{font-size:1.5rem}
  .logo-area{width:180px}
  main{padding:22px 15px 110px}
  .provider-header{padding:15px}
  .nav-inner{padding:0 7px;gap:3px}
  nav button{padding:13px 10px}
  .cards,.overview-cards{grid-template-columns:1fr}
  .login{margin:25px auto;padding:25px}
  .assistant{right:16px;bottom:16px}
  .panel,.card{padding:17px}
}
</style>
</head>
<body>

<header class="masthead">
  <div>
    <div class="brand">SMART<span>@</span>Clinic</div>
    <div class="small muted">Integrated provider workspace · Fictional demo</div>
  </div>
  <div class="logo-area">
    <img id="hospital-logo" alt="Cincinnati Children's" hidden>
    <div id="logo-fallback" class="logo-fallback">Cincinnati Children's</div>
    <button id="choose-logo" type="button" class="link logo-action">Choose logo</button>
  </div>
</header>
<input id="logo-file" type="file" accept="image/png,image/jpeg,image/webp" hidden>

<section id="login" class="login">
  <h1>Provider sign-in</h1>
  <p class="muted">Your patients. Your workflow. Your workspace.</p>
  <form id="login-form">
    <div class="field">
      <label for="username">First and last name</label>
      <input id="username" autocomplete="username" placeholder="Avery Patel" required>
    </div>
    <div class="field">
      <label for="password">Demo password</label>
      <input id="password" type="password" autocomplete="off" required>
    </div>
    <p id="login-error" class="error" role="alert"></p>
    <button id="password-login" class="primary" style="width:100%">Sign in</button>
  </form>
  <button id="device-login" type="button" style="width:100%;margin-top:10px">Use device unlock</button>
  <p class="note" style="margin-top:15px">
    Do not enter real credentials or patient information. Browser-only login
    is not secure clinical authentication.
  </p>
  <details open>
    <summary>Demo accounts</summary>
    <div class="account"><strong>Avery Patel</strong> · Pulmonology<br><code>AveryDemo!26</code></div>
    <div class="account"><strong>Morgan Lee</strong> · Neurology<br><code>MorganDemo!26</code></div>
    <div class="account"><strong>Riley Chen</strong> · Endocrinology<br><code>RileyDemo!26</code></div>
  </details>
  <button id="download-html" type="button" class="link small" style="margin-top:18px">Download clean HTML copy</button>
  <p id="file-status" class="note" role="status"></p>
</section>

<div id="workspace" hidden>
  <div class="provider-header">
    <div><strong id="provider-name"></strong><div id="provider-focus" class="note"></div></div>
    <button id="logout" type="button">Sign out</button>
  </div>
  <nav aria-label="Provider workspace">
    <div class="nav-inner">
      <button data-page="home">Dashboard home</button>
      <button data-page="calendar">Calendar</button>
      <button data-page="settings">Settings</button>
      <button data-page="chart" id="chart-tab" hidden>Patient chart</button>
    </div>
  </nav>
  <main>
    <div id="page"></div>
    <p id="status" class="note" role="status" aria-live="polite"></p>
    <footer>
      Fictional demo · Not an official hospital application · Dataset ends November 6, 2026.
      No live EHR, clinical monitoring, secure clinical authentication, automated claims,
      or validated clinical predictions.
    </footer>
  </main>
</div>

<dialog id="modal" aria-labelledby="modal-title">
  <div class="dialog-heading flex between">
    <h2 id="modal-title"></h2>
    <button id="close-modal" type="button">Close</button>
  </div>
  <div id="modal-body" class="dialog-body"></div>
</dialog>

<!-- Permanent shell: page rendering never replaces chatbot controls. -->
<aside id="assistant" class="assistant" aria-label="Optional chart assistant" hidden>
  <section id="assistant-panel" class="assistant-panel" aria-labelledby="assistant-title" hidden>
    <div class="assistant-header">
      <div class="flex">
        <h2 id="assistant-title">Chart assistant</h2>
        <span class="spacer"></span>
        <button id="assistant-close" type="button" class="assistant-close" aria-label="Close assistant">×</button>
      </div>
      <div id="assistant-context" class="assistant-context"></div>
    </div>
    <div class="assistant-disclaimer">
      Offline, rule-based review aid. Not a connected AI, diagnosis, or monitoring service.
    </div>
    <div id="assistant-messages" class="assistant-messages" role="log"
      aria-label="Assistant conversation" aria-live="polite" aria-relevant="additions" tabindex="0"></div>
    <div id="assistant-prompts" class="assistant-prompts"></div>
    <form id="assistant-form" class="assistant-form">
      <label for="assistant-input" class="small">Ask about the selected patient</label>
      <textarea id="assistant-input" rows="2" maxlength="1500"></textarea>
      <div class="flex">
        <button id="assistant-clear" type="button" class="link small">Clear conversation</button>
        <span class="spacer"></span>
        <button id="assistant-send" type="submit" class="primary">Send</button>
      </div>
      <p class="muted">Session only. Enter sends; Shift+Enter adds a line.</p>
    </form>
  </section>
  <button id="assistant-toggle" type="button" class="assistant-launcher"
    aria-expanded="false" aria-controls="assistant-panel">
    <span id="assistant-dot" class="assistant-dot" aria-hidden="true" hidden></span>
    <span id="assistant-label">Chart assistant</span>
  </button>
</aside>

<script>
(() => {
"use strict";

/* Connect only to a protected, authorized backend. Never embed an AI API key. */
const BILLING_AI_ENDPOINT=null;

const originalHTML="<!DOCTYPE html>\n"+document.documentElement.outerHTML;
const $=id=>document.getElementById(id);
const esc=v=>String(v??"").replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));
const END="2026-11-06",DAY=86400000,HISTORY_DAYS=540;
const finite=Number.isFinite;
const mean=a=>a.length?a.reduce((s,v)=>s+v,0)/a.length:null;
const shift=(s,n)=>new Date(Date.parse(s+"T12:00:00Z")+n*DAY).toISOString().slice(0,10);
const dateLabel=s=>new Date(s+"T12:00:00Z").toLocaleDateString(undefined,{
  month:"short",day:"numeric",year:"numeric",timeZone:"UTC"
});
const monday=s=>shift(s,-((new Date(s+"T12:00:00Z").getUTCDay()+6)%7));
const pct=(n,d)=>d?Math.round(n/d*100)+"%":"Unavailable";
const fmt=v=>finite(v)?Number(v.toFixed(2)).toLocaleString():"Unavailable";
function read(k,f=null){try{return JSON.parse(localStorage.getItem(k))??f}catch{return f}}
function store(k,v){try{localStorage.setItem(k,JSON.stringify(v));return true}catch{return false}}
function remove(k){try{localStorage.removeItem(k);return true}catch{return false}}
function options(map,current){
  return Object.entries(map).map(([v,label])=>
    `<option value="${esc(v)}" ${String(current)===v?"selected":""}>${esc(label)}</option>`
  ).join("");
}
function notify(message){$("status").textContent=message}
function download(content,type,name){
  const url=URL.createObjectURL(new Blob([content],{type}));
  const a=document.createElement("a");a.href=url;a.download=name;
  document.body.append(a);a.click();a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),1000);
}

/* ---------- Providers and independent fictional clinic records ---------- */
const providers=[
  {id:"avery",name:"Avery Patel",password:"AveryDemo!26",specialty:"Pulmonology",focus:"Asthma",type:"asthma",patients:["jordan","casey","sam"],metrics:["symptoms","rescue","fev1","medication"]},
  {id:"morgan",name:"Morgan Lee",password:"MorganDemo!26",specialty:"Neurology",focus:"Migraine",type:"migraine",patients:["alex","jamie","robin"],metrics:["symptoms","severity","acute","function"]},
  {id:"riley",name:"Riley Chen",password:"RileyDemo!26",specialty:"Endocrinology",focus:"Diabetes",type:"diabetes",patients:["taylor","drew","jessie"],metrics:["glucose","range","lowEvents","medication"]}
