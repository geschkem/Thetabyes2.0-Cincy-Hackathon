/* ---------- Monitoring aggregates and context summaries ---------- */
function aggregate(ds=selectedDays()){
  const reports=ds.map(d=>d.response).filter(Boolean);
  const doses=ds.flatMap(d=>d.doses),devices=ds.flatMap(d=>d.devices);
  return {
    days:ds,reports,doses,devices,answered:reports.length,missing:ds.length-reports.length,
    symptoms:reports.filter(r=>r.symptoms).length,
    activity:reports.filter(r=>r.activityLimited).length,
    taken:doses.filter(d=>d.status==="taken").length,
    notTaken:doses.filter(d=>d.status==="not_taken").length,
    noReport:doses.filter(d=>d.status==="no_report").length,
    fev:devices.filter(d=>d.type==="fev1"&&d.quality==="accepted"),
    glucose:devices.filter(d=>d.type==="glucose")
  };
}
function metricValue(id,a=aggregate()){
  const m={...metrics[id],label:metricLabel(id),value:"Unavailable",detail:"",count:a.answered};
  switch(id){
    case"symptoms":m.value=a.answered?`${a.symptoms} / ${a.answered}`:"Unavailable";m.detail=`Reporting days with symptoms · ${a.missing} days missing`;break;
    case"rescue":m.value=a.answered?String(a.reports.reduce((s,r)=>s+r.rescueUses,0)):"Unavailable";m.detail=`Reported uses · ${a.missing} days missing`;break;
    case"fev1":{
      const last=a.fev.at(-1);m.value=last?last.value.toFixed(2)+" L":"Unavailable";
      m.count=a.fev.length;m.detail=(last?last.timestamp.slice(0,10)+" · ":"")+a.devices.filter(r=>r.type==="fev1"&&r.quality!=="accepted").length+" rejected";break;
    }
    case"medication":m.value=pct(a.taken,a.doses.length);m.count=a.taken+a.notTaken;m.detail=`${a.taken}/${a.doses.length} scheduled · ${a.notTaken} not taken · ${a.noReport} unknown`;break;
    case"severity":m.value=a.answered?Math.max(...a.reports.map(r=>r.severity))+" / 10":"Unavailable";m.detail="Maximum reported score";break;
    case"acute":m.value=a.answered?a.reports.filter(r=>r.acuteMedication).length+" days":"Unavailable";m.detail="Reported use";break;
    case"function":m.value=a.answered?a.activity+" days":"Unavailable";m.detail=a.answered+" reporting days";break;
    case"glucose":m.count=a.glucose.length;m.value=m.count?Math.round(mean(a.glucose.map(r=>r.value)))+" mg/dL":"Unavailable";m.detail="Mean of individual spot readings · quality unknown";break;
    case"range":m.count=0;m.detail="No CGM series or prescribed target supplied";break;
    case"lowEvents":m.value=a.answered?String(a.reports.reduce((s,r)=>s+r.lowGlucoseEvents,0)):"Unavailable";m.detail="Patient-described events";break;
    case"coverage":m.value=`${a.answered} / ${a.days.length}`;m.detail="Days with a response";break;
    case"sleep":case"stress":{
      const v=a.reports.map(r=>id==="sleep"?r.sleepHours:r.stress).filter(finite);
      m.count=v.length;m.value=v.length?mean(v).toFixed(1)+(id==="sleep"?" h":" / 10"):"Unavailable";m.detail="Mean of reported values";break;
    }
  }
  return m;
}
function comparison(){
  const p=patient(),beforeStart=shift(p.lastVisit,-28),beforeEnd=shift(p.lastVisit,-1);
  const afterStart=shift(p.lastVisit,1);
  const before=p.days.filter(d=>d.date>=beforeStart&&d.date<=beforeEnd);
  const after=p.days.filter(d=>d.date>=afterStart&&d.date<=END);
  return {beforeStart,beforeEnd,afterStart,a:aggregate(before),b:aggregate(after)};
}
function comparisonRows(){
  const c=comparison(),a=c.a,b=c.b;
  const rows=[
    ["Reporting coverage",`${a.answered}/${a.days.length}`,`${b.answered}/${b.days.length}`],
    ["Doses marked taken",`${a.taken}/${a.doses.length} (${pct(a.taken,a.doses.length)})`,`${b.taken}/${b.doses.length} (${pct(b.taken,b.doses.length)})`],
    ["Unknown dose reports",a.noReport,b.noReport],
    ["Activity-limited days",`${a.activity}/${a.answered}`,`${b.activity}/${b.answered}`]
  ];
  if(state.provider.type==="diabetes"){
    rows.unshift(["Patient-described low-glucose events",a.reports.reduce((s,r)=>s+r.lowGlucoseEvents,0),b.reports.reduce((s,r)=>s+r.lowGlucoseEvents,0)]);
    rows.push(["Mean spot glucose",fmt(mean(a.glucose.map(r=>r.value)))+" mg/dL",fmt(mean(b.glucose.map(r=>r.value)))+" mg/dL"]);
  }else{
    rows.unshift(["Symptom days",`${a.symptoms}/${a.answered}`,`${b.symptoms}/${b.answered}`]);
    rows.push(state.provider.type==="asthma"
      ?["Mean accepted home FEV1",fmt(mean(a.fev.map(r=>r.value)))+" L",fmt(mean(b.fev.map(r=>r.value)))+" L"]
      :["Mean reported severity",fmt(mean(a.reports.map(r=>r.severity))),fmt(mean(b.reports.map(r=>r.severity)))]);
  }
  return rows;
}
