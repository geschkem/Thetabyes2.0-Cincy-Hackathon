/* ---------- Charts: missing values are not bridged ---------- */
function graph(rows,type,label,unit,{large=false,average=false,target=null}={}){
  const values=rows.flatMap(r=>[r.value,r.secondary]).filter(finite);
  if(!values.length)return '<p class="empty">No measured data available.</p>';
  const W=large?900:650,H=large?320:185,L=58,R=24,T=22,B=38;
  const w=W-L-R,h=H-T-B;
  let low=Math.min(...values),high=Math.max(...values);
  if(target){
    if(finite(target.lo))low=Math.min(low,target.lo);
    if(finite(target.hi))high=Math.max(high,target.hi);
  }
  if(type==="bar"||type==="area")low=Math.min(0,low);
  const padding=(high-low||1)*.1;low-=padding;high+=padding;
  const begin=Date.parse(rows[0].date),end=Date.parse(rows.at(-1).date);
  const X=s=>L+(end===begin?.5:(Date.parse(s)-begin)/(end-begin))*w;
  const Y=v=>T+h-(v-low)/(high-low)*h;
  let svg=`<svg ${large?'id="detail-svg"':""} viewBox="0 0 ${W} ${H}"
    role="img" aria-label="${esc(label+", "+unit+". Data table available in details.")}">`;
  if(target&&finite(target.lo)&&finite(target.hi)){
    svg+=`<rect x="${L}" y="${Y(target.hi)}" width="${w}" height="${Y(target.lo)-Y(target.hi)}" fill="var(--good)" opacity=".12"/>`;
  }
  for(let i=0;i<=4;i++){
    const v=low+(high-low)*i/4;
    svg+=`<line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}" stroke="var(--line)"/>
      <text x="${L-7}" y="${Y(v)+4}" text-anchor="end" fill="var(--muted)" font-size="10">${fmt(v)}</text>`;
  }
  const fields=rows.some(r=>finite(r.secondary))?[["value","var(--accent)",false],["secondary","var(--ink)",true]]:[["value","var(--accent)",false]];
  fields.forEach(([field,color,dashed],index)=>{
    if(type==="area"){
      let segment=[];
      const flush=()=>{
        if(segment.length){
          svg+=`<polygon points="${X(segment[0].date)},${Y(0)} ${segment.map(r=>X(r.date)+","+Y(r[field])).join(" ")} ${X(segment.at(-1).date)},${Y(0)}" fill="${color}" opacity=".12"/>`;
          segment=[];
        }
      };
      rows.forEach(r=>{if(finite(r[field]))segment.push(r);else flush()});flush();
    }
    rows.forEach((r,i)=>{
      const value=r[field];if(!finite(value))return;
      if(type==="bar"){
        const width=Math.min(24,w/Math.max(1,rows.length)*.7)/fields.length;
        const offset=fields.length===2?(index?0:-width):-width/2;
        const top=Math.min(Y(value),Y(0)),height=Math.max(1,Math.abs(Y(0)-Y(value)));
        svg+=`<rect x="${X(r.date)+offset}" y="${top}" width="${width}" height="${height}" fill="${color}">
          <title>${r.date}: ${value} ${esc(unit)}</title></rect>`;
      }else{
        const prev=rows[i-1];
        if(type!=="scatter"&&prev&&finite(prev[field])){
          svg+=`<line x1="${X(prev.date)}" y1="${Y(prev[field])}" x2="${X(r.date)}" y2="${Y(value)}"
            stroke="${color}" stroke-width="2" ${dashed?'stroke-dasharray="5 3"':""}/>`;
        }
        svg+=`<circle cx="${X(r.date)}" cy="${Y(value)}" r="${rows.length>100?1.8:3}" fill="${color}" opacity=".85">
          <title>${r.date}: ${value} ${esc(unit)}</title></circle>`;
      }
    });
  });
  if(average){
    const m=mean(rows.map(r=>r.value).filter(finite));
    svg+=`<line x1="${L}" x2="${W-R}" y1="${Y(m)}" y2="${Y(m)}" stroke="var(--ink)" stroke-dasharray="7 5"/>
      <text x="${L+5}" y="${Y(m)-7}" fill="var(--ink)" font-size="11">Mean ${fmt(m)}</text>`;
  }
  svg+=`<text x="${L}" y="${H-8}" fill="var(--muted)" font-size="10">${rows[0].date}</text>
    <text x="${W-R}" y="${H-8}" text-anchor="end" fill="var(--muted)" font-size="10">${rows.at(-1).date}</text>`;
  if(large){
    svg+=`<line id="crosshair" x1="${L}" x2="${L}" y1="${T}" y2="${H-B}" stroke="var(--ink)" opacity=".3"/>`;
    detailPlot={rows,W,L,R,X,unit};
  }
  return svg+"</svg>";
}
