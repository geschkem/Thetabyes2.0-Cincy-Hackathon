function overrides(sc){
  if(!S.p[sc])S.p[sc]={on:{}};
  if(!S.p[sc].on)S.p[sc].on={};
  return S.p[sc];
}
function getSetting(sc,key,id=null){
  /* Graph type is provider-wide, including on patient charts. */
  if(key==="chart")return S.g.chart[id];

  const obj=sc==="g"?S.g:overrides(sc);
  if(id!==null){
    return obj[key]&&Object.hasOwn(obj[key],id)
      ?obj[key][id]:S.g[key][id];
  }
  return obj[key]!==undefined?obj[key]:S.g[key];
}
function putSetting(sc,key,id,value){
  if(key==="chart"){
    S.g.chart[id]=value;
    return;
  }
  const obj=sc==="g"?S.g:overrides(sc);
  if(id===null)obj[key]=value;
  else{
    if(!obj[key])obj[key]={};
    obj[key][id]=value;
  }
}
function metricOrder(sc){
  const ids=[...new Set([
    ...(getSetting(sc,"order")||[]).filter(id=>MM[id]),
    ...M.map(m=>m.id)
  ])];
  return [
    ...ids.filter(id=>getSetting(sc,"on",id)),
    ...ids.filter(id=>!getSetting(sc,"on",id))
  ];
}
