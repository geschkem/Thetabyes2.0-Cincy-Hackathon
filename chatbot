function signOut(){
  if(busy)return;
  if((notes.length||Object.values(drafts).some(Boolean))&&
    !confirm("Sign out? Session notes and drafts will be discarded."))return;

  resetAssistant();
  provider=null;
  S=null;
  notes=[];
  drafts={};
  chartState=null;
  $("workspace").replaceChildren();
  $("workspace").hidden=true;
