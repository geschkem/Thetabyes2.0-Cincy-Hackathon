function showReading(index){
  const c=chartState;
  if(!c||!$("readout"))return;
  index=Math.max(0,Math.min(c.total-1,Math.round(index)));
  const projected=index>=c.n;
  const prediction=projected?c.predictions[index-c.n]:null;
  const value=projected?prediction.v:c.values[index];
  const text=
    `${dateLabel(date(index-c.n+1),true)} · `+
    `${projected?"Projected":"Recorded"}: ${fmt(value,c.m,true)} ${c.m.u}`+
    (projected
      ?` · Illustrative band ${fmt(prediction.low,c.m,true)}–${fmt(prediction.high,c.m,true)} ${c.m.u}`
      :c.m.lo==null?"":isOut(value,c.m)?" · Out of range":" · In range");

  $("readout").textContent=text;
  const x=c.L+index*(c.W-c.L-c.R)/Math.max(1,c.total-1);
  $("crosshair").setAttribute("x1",x);
  $("crosshair").setAttribute("x2",x);
  $("reading-slider").value=index;
  $("reading-slider").setAttribute("aria-valuetext",text);
}
function inspectPointer(event){
  const svg=event.target.closest("#detail-svg");
  if(!svg||!chartState)return;
  const bounds=svg.getBoundingClientRect();
  const x=(event.clientX-bounds.left)/bounds.width*chartState.W;
  showReading(
    (x-chartState.L)/(chartState.W-chartState.L-chartState.R)*
    (chartState.total-1)
  );
}

