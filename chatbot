/* Only workspace events are handled here. Chatbot events are separate. */
$("workspace").addEventListener("click",event=>{
  if(!provider||busy)return;
  const button=event.target.closest("[data-action]");
  if(!button)return;

  const action=button.dataset.action;
  const id=button.dataset.id;
  const sc=scope();
  let changed=false;

  if(action==="logout"){signOut();return}
  if(action==="patient"){openPatient(id);return}
  if(action==="metric"){openMetric(id);return}
  if(action==="register-device"){deviceAction(true);return}
  if(action==="ask-assistant"){setAssistantOpen(true);return}

  if(action==="forget-device"){
    try{
      localStorage.removeItem(deviceKey(provider.id));
      announce("Demo registration forgotten. A passkey may remain in your device password manager.");
    }catch{
      announce("Browser storage could not be updated.");
    }
    return;
  }

  if(action==="nav"){
    if(id==="patient"&&V.pid){
      V={page:"patient",pid:V.pid};
      patientTab="dash";
    }else{
      V={page:id};
      settingsTab="dash";
    }
    render();
    window.scrollTo(0,0);
    return;
  }

  if(action==="back"){
    V={page:"patient",pid:V.pid};
    patientTab="dash";
    render();
    window.scrollTo(0,backScroll);
    return;
  }

  if(action==="save-note"){
    const text=$("note-text").value.trim();
    if(!text){announce("Write a fictional note first.");return}
    if(!$("review-note").checked){
      announce("Review the note and check the accuracy confirmation.");
      return;
    }
    notes.push({
      pid:V.pid,author:provider.name,time:new Date().toLocaleString(),text
    });
    drafts[V.pid]="";
    $("note-text").value="";
    $("review-note").checked=false;
    $("notes").innerHTML=notesHTML(V.pid);
    announce("Reviewed note saved for this session.");
    return;
  }

  if(action==="patient-tab"){
    patientTab=id;settingsTab="dash";
  }else if(action==="settings-tab"){
    settingsTab=id;
  }else if(action==="period"){
    period=id;
  }else if(action==="cal-mode"){
    calMode=id;
  }else if(action==="cal-today"){
    calDate=END;
  }else if(action==="cal-shift"){
    calDate=shift(calDate,Number(id)*(calMode==="week"?7:1));
  }else if(action==="reset-patient"){
    if(!confirm("Reset this patient's display to provider defaults?"))return;
    S.p[sc]={on:{}};
    changed=true;
  }else if(action==="reset-metric"){
    delete overrides(sc).on[id];
    changed=true;
  }else if(action==="move"){
    const ids=metricOrder(sc);
    const i=ids.indexOf(id),j=i+Number(button.dataset.direction);
    if(j>=0&&j<ids.length){
      [ids[i],ids[j]]=[ids[j],ids[i]];
      putSetting(sc,"order",null,ids);
      changed=true;
    }
  }else if(action==="preset"){
    if(!confirm("Apply this preset to provider-wide displayed metrics?"))return;
    const ids=SPEC[S.g.spec][1];
    M.forEach(m=>S.g.on[m.id]=ids.includes(m.id));
    S.g.order=[...ids,...M.map(m=>m.id).filter(id=>!ids.includes(id))];
    changed=true;
  }else{
    return;
  }

  const saved=!changed||save();
  render();
  if(!saved)announce("Changes work for this session, but browser storage is unavailable.");
});

$("workspace").addEventListener("change",event=>{
  if(!provider||busy)return;
  const control=event.target;
  const key=control.dataset.change;
  const id=control.dataset.id;
  const sc=scope();
  if(!key)return;

  if(key==="patient"){openPatient(control.value);return}
  if(key==="sort")sort=control.value;
  else if(key==="preview")preview=control.value;
  else if(key==="on")putSetting(sc,"on",id,control.checked);
  else if(key==="chart")S.g.chart[id]=control.value;
  else if(key==="range")putSetting(sc,"range",null,Number(control.value));
  else if(key==="layout")putSetting(sc,"layout",null,control.value);
  else if(key==="alerts")putSetting(sc,"alerts",null,control.checked);
  else if(key==="detail-type"){
    detailType=control.value;
    S.g.chart[V.metric]=control.value;
  }
  else if(key==="average")showAverage=control.checked;
  else if(key==="projection")showProjection=control.checked;
  else if(key==="cal-date"){
    if(control.value)calDate=control.value;
  }
  else if(["hc","assistant","assistantCues"].includes(key)){
    S.g[key]=control.checked;
  }
  else if(key==="text")S.g.text=Number(control.value);
  else if(["theme","accent","spec","font","palette"].includes(key)){
    S.g[key]=control.value;
  }

  const saved=save();
  render();
  if(!saved)announce("Changes work for this session, but browser storage is unavailable.");
  else if(key==="chart"||key==="detail-type"){
    announce("Graph preference saved for all your patients.");
  }
});

$("workspace").addEventListener("input",event=>{
  if(!provider)return;
  if(event.target.id==="reading-slider"){
    showReading(Number(event.target.value));
  }else if(event.target.id==="note-text"){
    drafts[V.pid]=event.target.value;
    $("review-note").checked=false;
  }
});
$("workspace").addEventListener("pointermove",inspectPointer);
$("workspace").addEventListener("pointerdown",inspectPointer);

/* ---------- Optional chart assistant ---------- */
let assistantOpen=false;
let assistantThreads={};
let assistantDrafts={};
let assistantRenderedKey=null;

function resetAssistant(){
  assistantOpen=false;
  assistantThreads={};
  assistantDrafts={};
  assistantRenderedKey=null;
  $("assistant-panel").hidden=true;
  $("assistant-toggle").setAttribute("aria-expanded","false");
  $("assistant-messages").replaceChildren();
  $("assistant-input").value="";
}

function assistantContext(){
  if(!provider||!V.pid||!provider.patients.includes(V.pid))return null;

  const p=patient(V.pid);
  const focused=V.page==="metric"&&MM[V.metric]?V.metric:null;
  const days=focused?selectedPeriod().n:Number(getSetting(p.id,"range"));
  const ids=focused?[focused]:visibleMetrics(p.id);

  return {
    p,focused,days,
    metrics:ids.map(id=>{
      const m=MM[id],all=D[p.id][id];
      const recent=all.slice(-7);
      const baseline=all.slice(-35,-7);
      const recentMean=avg(recent);
      const baselineMean=avg(baseline);
      const spread=Math.sqrt(avg(baseline.map(v=>(v-baselineMean)**2)));
      const change=recentMean-baselineMean;

      return {
        id,m,latest:all.at(-1),
        periodMean:avg(all.slice(-days)),
        recentMean,baselineMean,change,
        outside:isOut(all.at(-1),m),
        outsideCount:recent.filter(v=>isOut(v,m)).length,
        /* Heuristic review cue only; not clinically validated. */
        shifted:Math.abs(change)>Math.max(
          spread*2,Math.abs(baselineMean)*.05,m.d?.1:1
        )
      };
    })
  };
}

function assistantSuggestions(context){
  if(!context)return [];

  const suggestions=[
    {text:"Summarize the displayed measurements",kind:"summary"}
  ];

  if(S.g.assistantCues){
    const outside=context.metrics.find(x=>x.outside);
    const shifted=context.metrics
      .filter(x=>x.shifted&&x.id!==outside?.id)
      .sort((a,b)=>
        Math.abs(b.change)/Math.max(1,Math.abs(b.baselineMean))-
        Math.abs(a.change)/Math.max(1,Math.abs(a.baselineMean))
      )[0];

    if(outside){
      suggestions.push({
        text:`What should I review about ${metricName(outside.m).toLowerCase()}?`,
        kind:"metric",id:outside.id
      });
    }else if(context.focused&&context.metrics[0]){
      suggestions.push({
        text:"Help me review this metric",
        kind:"metric",id:context.metrics[0].id
      });
    }
    if(shifted){
      suggestions.push({
        text:`How has ${metricName(shifted.m).toLowerCase()} changed?`,
        kind:"metric",id:shifted.id
      });
    }
  }

  suggestions.push({
    text:"Suggest questions for the patient",
    kind:"questions"
  });
  return suggestions;
}

function assistantGreeting(context){
  if(!context){
    return "Open a patient chart to review that patient's measurements. I keep each patient's conversation separate and won't combine their data.";
  }

  const focus=context.focused
    ?`the selected ${metricName(MM[context.focused]).toLowerCase()} chart`
    :"the displayed dashboard metrics";
  const outside=context.metrics.find(x=>x.outside);

  let text=`Reviewing ${fullName(context.p)} — ${focus}.\n\n`;
  if(S.g.assistantCues&&outside){
    text+=`${metricName(outside.m)} is ${fmt(outside.latest,outside.m)} ${outside.m.u}, outside the shared demo target.\n\nWould it help to review the recent readings and consider whether the target and measurement conditions are appropriate?`;
  }else{
    text+="I can summarize recorded readings and suggest questions to explore. Choose a prompt below or ask about a displayed metric.";
  }
  return text;
}

function makeAssistantMessage(role,text){
  const item=document.createElement("div");
  item.className="assistant-message"+(role==="user"?" user":"");

  const author=document.createElement("strong");
  author.textContent=role==="user"?"You":"Chart assistant";

  const body=document.createElement("p");
  body.textContent=text;

  item.append(author,body);
  return item;
}

function updateAssistant(){
  if(!provider||!S){
    $("assistant").hidden=true;
    return;
  }

  $("assistant").hidden=!S.g.assistant;
  if(!S.g.assistant)assistantOpen=false;
  $("assistant-panel").hidden=!assistantOpen;
  $("assistant-toggle").setAttribute("aria-expanded",String(assistantOpen));

  const context=assistantContext();
  const cue=Boolean(
    S.g.assistantCues&&context?.metrics.some(x=>x.outside||x.shifted)
  );
  $("assistant-dot").hidden=!cue;
  $("assistant-launcher-label").textContent=assistantOpen
    ?"Close assistant"
    :cue?"Chart assistant · Review cues":"Chart assistant";

  $("assistant-context").textContent=context
    ?`${fullName(context.p)}${context.focused?" · "+metricName(MM[context.focused]):""} · Recorded data`
    :"No patient selected";

  const input=$("assistant-input");
  input.disabled=!context;
  $("assistant-send").disabled=!context;
  input.placeholder=context
    ?"Try “Summarize” or ask about a metric…"
    :"Open a patient chart first";
  input.value=context?(assistantDrafts[context.p.id]||""):"";

  const thread=context?(assistantThreads[context.p.id]||[]):[];
  $("assistant-clear").disabled=!thread.length;

  const renderKey=JSON.stringify([
    context?.p.id,context?.focused,context?.days,
    context?.metrics.map(x=>x.id),S.g.assistantCues,thread.length
  ]);

  if(renderKey!==assistantRenderedKey){
    const messages=$("assistant-messages");
    messages.replaceChildren(
      makeAssistantMessage("assistant",assistantGreeting(context))
    );
    thread.forEach(message=>{
      messages.append(makeAssistantMessage(message.role,message.text));
    });
    assistantRenderedKey=renderKey;
    messages.scrollTop=messages.scrollHeight;
  }

  const prompts=$("assistant-prompts");
  prompts.replaceChildren();
  assistantSuggestions(context).forEach(suggestion=>{
    const button=document.createElement("button");
    button.type="button";
    button.textContent=suggestion.text;
    button.addEventListener("click",()=>{
      sendAssistant(suggestion.text,suggestion.kind,suggestion.id);
    });
    prompts.append(button);
  });
}

function setAssistantOpen(open){
  if(!provider||!S?.g.assistant)return;
  assistantOpen=Boolean(open);
  updateAssistant();

  if(assistantOpen){
    requestAnimationFrame(()=>{
      const messages=$("assistant-messages");
      messages.scrollTop=messages.scrollHeight;
      if(assistantContext())$("assistant-input").focus();
      else $("assistant-close").focus();
    });
  }else{
    $("assistant-toggle").focus();
  }
}

function assistantSummary(context){
  if(!context.metrics.length){
    return "No metrics are displayed. Enable a metric in this patient's dashboard settings to review it here.";
  }

  const lines=context.metrics.map(x=>
    `• ${metricName(x.m)}: latest ${fmt(x.latest,x.m)} ${x.m.u}; `+
    `${context.days}-day mean ${fmt(x.periodMean,x.m,true)} ${x.m.u}`+
    (x.outside?" — outside shared demo target.":".")
  );

  return `${fullName(context.p)} — recorded measurements
Through ${dateLabel(date(),true)}.

${lines.join("\n")}

Scope: ${context.focused?"the selected metric":"currently displayed dashboard metrics"}.
Targets are shared demo values, not individualized clinical thresholds. This summary does not include projected readings.`;
}

function assistantMetricResponse(x,context){
  const rangeText=x.m.lo==null
    ?"No target is configured."
    :`Shared demo target: ${target(x.m)}.`;
  const status=x.m.lo==null?"":x.outside
    ?`The latest reading is ${x.latest<x.m.lo?"below":"above"} that range. ${x.outsideCount} of the last 7 daily readings were outside it.`
    :"The latest reading is within that range.";

  return `${metricName(x.m)} — ${fullName(context.p)}
Recorded through ${dateLabel(date(),true)}.

Latest: ${fmt(x.latest,x.m)} ${x.m.u}.
${rangeText}
${status}

Last 7 days: mean ${fmt(x.recentMean,x.m,true)} ${x.m.u}.
Preceding 28 days: mean ${fmt(x.baselineMean,x.m,true)} ${x.m.u}.
Difference: ${x.change>0?"+":""}${fmt(x.change,x.m,true)} ${x.m.u}.

Questions to consider:
• Is this target appropriate for this patient?
• Were device, technique, timing, and measurement conditions comparable?
• Do symptoms or recent patient-reported changes provide relevant context?

These observations do not establish a cause, diagnosis, or treatment recommendation.`;
}

function assistantQuestions(context){
  const outside=context.metrics.filter(x=>x.outside);
  return `Possible discussion questions for ${fullName(context.p)}:

${outside.length
    ?`• For ${outside.map(x=>metricName(x.m).toLowerCase()).join(", ")}, are the targets appropriate and the measurements reliable?`
    :"• Are the configured targets appropriate for this patient's care plan?"}
• Has the patient noticed symptoms around the recorded changes?
• Were readings taken at comparable times and under similar conditions?
• Have there been changes in routine, activity, illness, or prescribed medication use?
• Are missing readings or device issues affecting interpretation?

I don't have patient messages, medication records, or symptom reports in this prototype. These are questions to investigate, not conclusions.`;
}

function assistantReply(text,kind,id,context){
  if(kind==="summary")return assistantSummary(context);
  if(kind==="questions")return assistantQuestions(context);
  if(kind==="metric"){
    const metric=context.metrics.find(x=>x.id===id);
    return metric?assistantMetricResponse(metric,context):assistantSummary(context);
  }

  const q=text.toLowerCase();

  if(/diagnos|prescrib|treat|dosage|\bdose\b|emergency|urgent|should i/.test(q)){
    return "This offline demo cannot diagnose, recommend treatment or medication changes, or assess urgency. Use verified clinical information and your established clinical workflow.\n\nI can summarize recorded measurements and suggest questions to investigate.";
  }
  if(/message|caretaker|caregiver|parent|chat history/.test(q)){
    return "Patient and caregiver messages are not connected to this assistant, so I can't summarize them.\n\nA production version should only access messages the clinician is authorized to view, with patient consent and proxy-access rules enforced by the backend.";
  }
  if(/forecast|predict|projection/.test(q)){
    return "The chart projection is an illustrative straight-line extrapolation, not a validated patient forecast.\n\nMy review cues use recorded measurements only. The displayed projection and uncertainty band should not be treated as clinical predictions.";
  }
  if(/summar|overview/.test(q))return assistantSummary(context);
  if(/question|ask patient|discuss/.test(q))return assistantQuestions(context);

  const aliases={
    hr:/heart|\bbpm\b|pulse/,
    bp:/blood pressure|systolic|\bbp\b/,
    spo2:/oxygen|spo2|saturation/,
    rr:/respirat|breathing/,
    temp:/temperature|fever/,
    wt:/weight/,
    glu:/glucose|blood sugar/,
    water:/water|hydrat/,
    sleep:/sleep/,
    act:/activity|exercise/,
    steps:/steps|walking/
  };
  const namedId=M.find(m=>aliases[m.id]?.test(q))?.id;
  if(namedId){
    const x=context.metrics.find(x=>x.id===namedId);
    if(x)return assistantMetricResponse(x,context);
    return `${metricName(MM[namedId])} is not in my current chart context. Open that metric's detail view, or return to the dashboard and enable it, then ask again.`;
  }

  if(/range|flag|odd|unusual|change|trend|why/.test(q)){
    const x=context.metrics.find(x=>x.outside)||
      context.metrics.find(x=>x.shifted)||context.metrics[0];
    if(x)return assistantMetricResponse(x,context);
  }

  if(/hello|^hi\b|help/.test(q)){
    return "I can help with three demo tasks:\n\n• Summarize displayed measurements.\n• Review a metric's latest reading and recent averages.\n• Suggest questions for your patient conversation.\n\nTry a suggested prompt or ask about a displayed metric.";
  }

  return "This is a rule-based preview, not a connected language model, so I can't reason freely about that message.\n\nTry “Summarize the displayed measurements,” ask about a visible metric, or choose a suggested question.";
}

function sendAssistant(text,kind="free",id=null){
  const context=assistantContext();
  if(!context||!text.trim())return;

  const clean=text.trim().slice(0,1200);
  if(!assistantThreads[context.p.id])assistantThreads[context.p.id]=[];
  const thread=assistantThreads[context.p.id];

  const userMessage={role:"user",text:clean};
  const answerMessage={
    role:"assistant",text:assistantReply(clean,kind,id,context)
  };
  thread.push(userMessage,answerMessage);

  assistantDrafts[context.p.id]="";
  $("assistant-input").value="";

  /* Append only new messages so screen readers do not repeat the whole thread. */
  const messages=$("assistant-messages");
  messages.append(
    makeAssistantMessage(userMessage.role,userMessage.text),
    makeAssistantMessage(answerMessage.role,answerMessage.text)
  );

  assistantRenderedKey=JSON.stringify([
    context.p.id,context.focused,context.days,
    context.metrics.map(x=>x.id),S.g.assistantCues,thread.length
  ]);
  $("assistant-clear").disabled=false;
  messages.scrollTop=messages.scrollHeight;
  $("assistant-input").focus();
}

/* Direct listeners on permanent elements: reliable expand/collapse. */
$("assistant-toggle").addEventListener("click",()=>{
  setAssistantOpen(!assistantOpen);
});
$("assistant-close").addEventListener("click",()=>{
  setAssistantOpen(false);
});
$("assistant-form").addEventListener("submit",event=>{
  event.preventDefault();
  sendAssistant($("assistant-input").value);
});
$("assistant-input").addEventListener("input",()=>{
  const context=assistantContext();
  if(context)assistantDrafts[context.p.id]=$("assistant-input").value;
});
$("assistant-input").addEventListener("keydown",event=>{
  if(event.key==="Enter"&&!event.shiftKey&&!event.isComposing){
    event.preventDefault();
    sendAssistant($("assistant-input").value);
  }
});
$("assistant-clear").addEventListener("click",()=>{
  const context=assistantContext();
  if(!context)return;
  assistantThreads[context.p.id]=[];
  assistantDrafts[context.p.id]="";
  assistantRenderedKey=null;
  updateAssistant();
  $("assistant-input").focus();
});
document.addEventListener("keydown",event=>{
  if(event.key==="Escape"&&assistantOpen)setAssistantOpen(false);
});

document.documentElement.dataset.theme="light";
document.documentElement.style.fontSize="14px";
</script>
