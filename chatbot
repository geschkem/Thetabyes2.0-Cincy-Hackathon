function statusChip(pid,id){
  const m=MM[id];
  const value=current(pid,id);
  if(m.lo==null)return '<span class="chip">No target</span>';
  if(!isOut(value,m))return '<span class="chip good">✓ In range</span>';
  return '<span class="chip bad">⚠ Out of range</span>';
}
function chartSelect(id){
  return `
    <select data-change="chart" data-id="${id}"
      aria-label="${MM[id].n} graph type for all patients">
      ${Object.entries(CH).map(([k,label])=>`
        <option value="${k}" ${S.g.chart[id]===k?"selected":""}>
          ${label}
        </option>`).join("")}
    </select>`;
}
function spark(values,m,type){
  if(type==="number")return "";

  if(type==="progress"){
    if(!m.goal)return '<p class="note">No progress goal configured.</p>';
    const percent=values.at(-1)/m.goal*100;
    return `
      <div class="progress" role="progressbar"
        aria-label="${m.n} goal" aria-valuemin="0" aria-valuemax="100"
        aria-valuenow="${Math.min(100,Math.round(percent))}">
        <b style="width:${Math.max(0,Math.min(100,percent))}%"></b>
      </div>
      <div class="note">
        ${Math.round(percent)}% of ${m.goal} ${m.u} demo goal
      </div>`;
  }

  const W=300,H=75;
  const min=Math.min(...values),max=Math.max(...values);
  const X=i=>i*W/Math.max(1,values.length-1);
  const Y=v=>H-5-(v-min)/(max-min||1)*(H-12);
  const points=values.map((v,i)=>`${X(i)},${Y(v)}`).join(" ");

  const drawing=type==="bar"
    ?values.map((v,i)=>{
      const width=W/values.length;
      const height=Math.max(2,v/Math.max(1,max)*(H-5));
      return `<rect x="${i*width+width*.15}" y="${H-height}"
        width="${width*.7}" height="${height}" fill="var(--acc)"/>`;
    }).join("")
    :`${type==="area"?`
      <polygon points="0,${H} ${points} ${W},${H}"
        fill="var(--acc)" opacity=".15"/>`:""}
      <polyline points="${points}" fill="none"
        stroke="var(--acc)" stroke-width="2.5"/>`;

  return `
    <svg class="spark" viewBox="0 0 ${W} ${H}" role="img"
      aria-label="${m.n}, recent recorded trend">${drawing}</svg>`;
}

function dashboard(sc,pid,previewOnly=false){
  const ids=metricOrder(sc).filter(id=>
    getSetting(sc,"on",id)||isOut(current(pid,id),MM[id])
  );
