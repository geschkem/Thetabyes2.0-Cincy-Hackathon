function signIn(p){
  provider=p;
  const base=defaults();
  const saved=readStorage(settingsKey(),{});

  S={
    g:{
      ...base,...saved.g,
      on:{...base.on,...saved.g?.on},
      chart:{...base.chart,...saved.g?.chart}
    },
    p:saved.p||{}
  };

  if(!saved.g){
    S.g.spec=p.spec;
    const ids=SPEC[p.spec][1];
    M.forEach(m=>S.g.on[m.id]=ids.includes(m.id));
    S.g.order=[...ids,...M.map(m=>m.id).filter(id=>!ids.includes(id))];
  }

  preview=p.patients[0];
  V={page:"home"};
  patientTab="dash";
