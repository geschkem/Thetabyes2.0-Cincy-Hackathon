<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SMART@Clinic</title>
<style>
:root{
  --bg:#f8fbfc;--card:#fff;--ink:#132c3b;--mut:#426478;
  --line:#d4e9e9;--acc:#087e88;--tint:#eaf8f6;
  --good:#1d7a4d;--bad:#b3261e;--warn:#9b5800;
}
:root[data-theme="dark"]{
  --bg:#0f1b20;--card:#172a31;--ink:#e8f1f3;--mut:#abc0c8;
  --line:#35505a;--tint:#1d3640;--good:#5fd39a;
  --bad:#ff8a80;--warn:#f0b05a;
}
@media(prefers-color-scheme:dark){
  :root[data-theme="system"]{
    --bg:#0f1b20;--card:#172a31;--ink:#e8f1f3;--mut:#abc0c8;
    --line:#35505a;--tint:#1d3640;--good:#5fd39a;
    --bad:#ff8a80;--warn:#f0b05a;
  }
}
:root[data-hc="true"]{--line:var(--ink);--mut:var(--ink)}
:root[data-palette="accessible"]{
  --good:#0072b2;--bad:#b34d00;--warn:#8057a6;
}
:root[data-font="readable"] body{
  font-family:Verdana,Arial,sans-serif;
  letter-spacing:.035em;word-spacing:.08em;line-height:1.75;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:"Avenir Next",Avenir,"Trebuchet MS",Arial,sans-serif;
  line-height:1.55;
}
button,input,select,textarea{font:inherit;color:inherit}
button,select,input,textarea{
  border:1px solid var(--line);border-radius:6px;
  background:var(--card);padding:9px 12px;
}
button{cursor:pointer;font-weight:600}
button:hover{background:var(--tint)}
button:disabled{opacity:.45;cursor:not-allowed}
:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
input[type=checkbox]{
  width:18px;height:18px;accent-color:var(--acc);padding:0;
}
textarea{width:100%;min-height:110px;resize:vertical}
.primary{background:var(--acc);color:#fff;border-color:var(--acc)}
.primary:hover{background:var(--acc);filter:brightness(.94)}
.link{
  border:0;background:none;padding:0;
  color:var(--acc);text-decoration:underline;
}
h1{
  font-size:1.9rem;line-height:1.2;
  letter-spacing:-.6px;margin:0 0 12px;
}
h2{font-size:1.15rem;margin:0 0 12px}
h3{font-size:1rem;margin:0 0 8px}
p{margin:10px 0}
.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.sp{flex:1}
.stack{display:grid;gap:18px}
.muted,.note{color:var(--mut)}
.note{font-size:.8rem}
.good{color:var(--good)}
.bad{color:var(--bad)}
.warn{color:var(--warn)}
.brand{
  font-size:1.9rem;font-weight:800;letter-spacing:-1px;
  border:0;padding:0;background:none;
}
.brand span{color:var(--acc)}
.login{
  width:min(470px,calc(100% - 32px));margin:50px auto;padding:32px;
  background:var(--card);
  border:1px solid var(--line);border-top:3px solid var(--acc);
  border-radius:10px;
}
.login h1{font-size:1.7rem;margin-top:28px}
.field{margin:18px 0}
.field label{
  display:block;font-size:.8rem;font-weight:700;margin-bottom:6px;
}
.field input{width:100%}
.login details{
  margin-top:22px;padding-top:16px;border-top:1px solid var(--line);
}
.account{padding:10px 0;border-bottom:1px solid var(--line)}
.error{color:var(--bad);min-height:22px;font-size:.85rem}
header{
  padding:24px max(24px,calc((100vw - 1220px)/2));
  border-bottom:2px solid var(--acc);background:var(--card);
}
nav{
  position:sticky;top:0;z-index:20;background:var(--card);
  border-bottom:1px solid var(--line);
}
.nav-inner{
  max-width:1220px;margin:auto;display:flex;gap:8px;
  overflow:auto;padding:0 24px;
}
nav button{
  border:0;border-bottom:2px solid transparent;border-radius:0;
  padding:14px;white-space:nowrap;color:var(--mut);
}
nav button.on{
  color:var(--acc);border-bottom-color:var(--acc);background:var(--tint);
}
main{max-width:1220px;margin:auto;padding:28px 24px 120px}
.welcome{padding:5px 0 25px}
.date{
  font-size:.75rem;letter-spacing:1px;color:var(--acc);
  font-weight:700;margin-bottom:12px;
}
.panel,.card{
  background:var(--card);border:1px solid var(--line);
  border-radius:9px;padding:22px;min-width:0;
}
.home-grid,.two{
  display:grid;grid-template-columns:1.3fr 1fr;
  gap:18px;align-items:start;
}
.patient-panel{border-top:3px solid var(--acc)}
.grid{
  display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;
}
.grid.list{grid-template-columns:1fr}
.metric-card.out{border:2px solid var(--bad)}
.title{
  border:0;background:none;padding:0;text-align:left;font-size:.95rem;
}
.title:hover{text-decoration:underline}
.big{
  font-size:2rem;color:var(--acc);font-weight:750;letter-spacing:-.5px;
}
.unit{font-size:.85rem;color:var(--mut)}
.chip{
  display:inline-flex;gap:4px;align-items:center;border-radius:99px;
  padding:3px 10px;font-size:.78rem;font-weight:600;
  background:var(--tint);border:1px solid var(--line);
}
.spark{width:100%;height:75px;margin:10px 0}
.card-controls{
  margin-top:14px;padding-top:12px;border-top:1px solid var(--line);
}
.card-controls select{font-size:.8rem;padding:5px 7px;max-width:145px}
.av{
  display:grid;place-items:center;width:46px;height:46px;flex:none;
  background:var(--tint);color:var(--acc);border-radius:50%;font-weight:700;
}
.patient-row{
  width:100%;text-align:left;display:flex;gap:12px;align-items:center;
  flex-wrap:wrap;padding:15px 0;border:0;
  border-bottom:1px solid var(--line);border-radius:0;
}
.tabs{
  display:flex;gap:6px;border-bottom:1px solid var(--line);
  margin:18px 0;flex-wrap:wrap;
}
.tabs button{border:0;border-bottom:2px solid transparent;border-radius:0}
.tabs button.on{border-color:var(--acc);color:var(--acc)}
.setting-row{
  display:flex;align-items:center;gap:9px;flex-wrap:wrap;
  padding:12px 0;border-bottom:1px solid var(--line);
}
.setting-row .nm{flex:1;min-width:130px}
.setting-row select{max-width:135px;padding:5px}
.badge{
  font-size:.7rem;border:1px solid var(--line);
  padding:2px 6px;border-radius:4px;
}
.lab{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.preview .grid{grid-template-columns:1fr}
.preview .big{font-size:1.4rem}
.preview .card{padding:14px}
.notice{
  background:var(--tint);border:1px solid var(--line);
  border-radius:6px;padding:13px;font-size:.8rem;
}
.progress{
  height:12px;background:var(--tint);border-radius:9px;
  overflow:hidden;margin-top:12px;
}
.progress b{display:block;background:var(--acc);height:100%}
.stats{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));
  gap:12px;
}
.stat{font-size:1.3rem;font-weight:700;margin-top:5px}
.chart-scroll{overflow:auto}
.detail-chart{display:block;width:100%;min-width:650px}
.readout{
  padding:12px;background:var(--tint);border-radius:5px;
  font-size:.85rem;min-height:46px;
}
.slider{
  display:flex;align-items:center;gap:10px;margin-top:12px;font-size:.8rem;
}
.slider input{flex:1;accent-color:var(--acc);padding:0;min-width:100px}
.legend{
  display:flex;gap:15px;flex-wrap:wrap;margin-top:12px;
  font-size:.75rem;color:var(--mut);
}
.legend span{display:inline-flex;align-items:center;gap:6px}
.key{width:23px;border-top:3px solid var(--acc)}
.key.avg{border-color:var(--ink);border-top-style:dashed}
.key.pred{border-color:var(--warn);border-top-style:dotted}
.key.target{height:12px;border:0;background:var(--good);opacity:.25}
table{border-collapse:collapse;width:100%;font-size:.8rem}
th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}
th{background:var(--tint)}
summary{cursor:pointer}
.event{
  display:block;width:100%;text-align:left;margin:10px 0;
  background:var(--tint);border-left:3px solid var(--acc);
}
.week{
  display:grid;grid-template-columns:repeat(7,minmax(145px,1fr));
  min-width:1015px;
}
.day{
  padding:14px;border-right:1px solid var(--line);min-height:220px;
}
.day:last-child{border:0}
.today{background:var(--tint)}
.note-entry{padding:12px 0;border-top:1px solid var(--line)}
.note-entry p{white-space:pre-wrap}
footer{
  font-size:.75rem;color:var(--mut);border-top:1px solid var(--line);
  margin-top:28px;padding-top:18px;
}

/* Permanent chatbot shell: never replaced during app rendering. */
.assistant{
  position:fixed;right:20px;bottom:20px;z-index:100;
  display:flex;flex-direction:column;align-items:flex-end;gap:10px;
}
.assistant-launcher{
  display:flex;align-items:center;gap:9px;
  padding:13px 18px;border-radius:999px;
  color:#fff;background:var(--acc);border-color:var(--acc);
  box-shadow:0 6px 24px #0003;
}
.assistant-launcher:hover{background:var(--acc);filter:brightness(.95)}
.assistant-dot{
  width:9px;height:9px;border-radius:50%;background:#fff;
}
.assistant-panel{
  width:min(405px,calc(100vw - 32px));
  height:min(640px,calc(100dvh - 105px));
  display:flex;flex-direction:column;overflow:hidden;
  border:1px solid var(--line);border-radius:14px;
  background:var(--card);box-shadow:0 12px 45px #0003;
}
.assistant-header{
  padding:14px 16px;border-bottom:1px solid var(--line);flex:none;
}
.assistant-header h2{margin:0;font-size:1rem}
.assistant-context{font-size:.76rem;color:var(--mut);margin-top:5px}
.assistant-close{font-size:1.25rem;padding:2px 10px;border:0}
.assistant-disclaimer{
  background:var(--tint);color:var(--mut);
  padding:9px 16px;font-size:.73rem;flex:none;
}
.assistant-messages{
  flex:1;min-height:75px;overflow:auto;
  display:flex;flex-direction:column;gap:12px;padding:15px;
  overscroll-behavior:contain;
}
.assistant-message{
  max-width:95%;padding:11px 13px;border:1px solid var(--line);
  border-radius:10px;background:var(--tint);
  font-size:.84rem;overflow-wrap:anywhere;
}
.assistant-message.user{align-self:flex-end;background:var(--card)}
.assistant-message strong{
  display:block;font-size:.72rem;color:var(--mut);margin-bottom:5px;
}
.assistant-message p{margin:0;white-space:pre-wrap}
.assistant-prompts{
  display:grid;gap:6px;padding:0 15px 10px;
  flex:none;max-height:145px;overflow:auto;
}
.assistant-prompts button{
  font-size:.76rem;padding:7px 10px;text-align:left;font-weight:500;
}
.assistant-form{
  padding:10px 15px;border-top:1px solid var(--line);flex:none;
}
.assistant-form textarea{
  min-height:55px;height:60px;max-height:100px;font-size:.84rem;
}
.assistant-form .row{margin-top:7px}
.assistant-form .note{font-size:.72rem}
.assistant-form p{margin:7px 0 0}
@media(max-width:850px){
  .home-grid,.two{grid-template-columns:1fr}
}
@media(max-width:600px){
  header{padding:20px 16px}
  main{padding:22px 16px 110px}
  .nav-inner{padding:0 8px}
  .grid{grid-template-columns:1fr}
  .panel,.card{padding:17px}
  .login{padding:25px;margin:30px auto}
  .brand{font-size:1.6rem}
  .assistant{right:16px;bottom:16px}
}
</style>
</head>
<body>

<section id="login" class="login">
  <div class="brand">SMART<span>@</span>Clinic</div>
  <h1>Provider sign-in</h1>
  <p class="muted">Your patients, your schedule, your workspace.</p>

  <form id="login-form">
    <div class="field">
      <label for="username">First and last name</label>
      <input id="username" placeholder="Avery Patel"
        autocomplete="username" required>
    </div>
    <div class="field">
      <label for="password">Demo password</label>
      <input id="password" type="password" autocomplete="off" required>
    </div>
    <p id="login-error" class="error" role="alert"></p>
    <button class="primary" style="width:100%">Sign in</button>
  </form>

  <button id="unlock" type="button" style="width:100%;margin-top:10px">
    Use device unlock
  </button>

  <p class="note">
    Fictional demonstration only. Do not enter a real password or patient
    information. This browser-only prototype is not secure clinical authentication.
  </p>

  <details open>
    <summary class="note">Demo accounts</summary>
    <div class="account note">
      <b>Avery Patel</b> · Pulmonology<br>
      Password: <code>AveryDemo!26</code>
    </div>
    <div class="account note">
      <b>Morgan Lee</b> · Neurology<br>
      Password: <code>MorganDemo!26</code>
    </div>
    <div class="account note">
      <b>Riley Chen</b> · Endocrinology<br>
      Password: <code>RileyDemo!26</code>
    </div>
    <p class="note">
      Device unlock requires HTTPS or localhost and registration after sign-in.
    </p>
  </details>
</section>

<div id="workspace" hidden></div>

<!--
  This chatbot is outside the dynamically rendered workspace.
  Its buttons and event listeners remain intact when pages change.
-->
<aside id="assistant" class="assistant" aria-label="Optional chart assistant" hidden>
  <section id="assistant-panel" class="assistant-panel"
    aria-labelledby="assistant-title" hidden>
    <div class="assistant-header">
      <div class="row">
        <h2 id="assistant-title">Chart assistant</h2>
        <span class="sp"></span>
        <button id="assistant-close" type="button" class="assistant-close"
          aria-label="Close chart assistant">×</button>
      </div>
      <div id="assistant-context" class="assistant-context"></div>
    </div>

    <div class="assistant-disclaimer">
      Offline, rule-based demo—not a connected AI, diagnosis, or clinical
      monitoring service.
    </div>

    <div id="assistant-messages" class="assistant-messages"
      role="log" aria-label="Assistant conversation"
      aria-live="polite" aria-relevant="additions" tabindex="0"></div>

    <div id="assistant-prompts" class="assistant-prompts"></div>

    <form id="assistant-form" class="assistant-form">
      <label for="assistant-input" class="note">Ask about this patient's chart</label>
      <textarea id="assistant-input" rows="2" maxlength="1200"
        placeholder="Ask about a displayed metric…"></textarea>
      <div class="row">
        <button id="assistant-clear" type="button" class="link note">
          Clear conversation
        </button>
        <span class="sp"></span>
        <button id="assistant-send" type="submit" class="primary">Send</button>
      </div>
      <p class="note">Session only. Do not enter real patient information.</p>
    </form>
  </section>

  <button id="assistant-toggle" type="button" class="assistant-launcher"
    aria-expanded="false" aria-controls="assistant-panel">
    <span id="assistant-dot" class="assistant-dot" aria-hidden="true" hidden></span>
    <span id="assistant-launcher-label">Chart assistant</span>
  </button>
</aside>

<script>
"use strict";

/* ---------- Utilities and fictional data ---------- */
const $=id=>document.getElementById(id);
const esc=value=>String(value).replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));

const END="2026-11-06";
const DAY=86400000;

const PROVIDERS=[
  {
    id:"avery",name:"Avery Patel",password:"AveryDemo!26",
    specialty:"Pulmonology",spec:"pulm",patients:["p2","p4","p5"]
  },
  {
    id:"morgan",name:"Morgan Lee",password:"MorganDemo!26",
    specialty:"Neurology",spec:"neuro",patients:["p3","p4","p5"]
  },
  {
    id:"riley",name:"Riley Chen",password:"RileyDemo!26",
    specialty:"Endocrinology",spec:"endo",patients:["p1","p3","p6"]
  }
];

const M=[
  {id:"hr",n:"Heart rate",u:"bpm",lo:55,hi:100,b:72,c:"line"},
  {id:"bp",n:"Blood pressure",u:"mmHg",lo:90,hi:130,b:122,c:"line"},
  {id:"spo2",n:"Oxygen saturation",u:"%",lo:94,hi:100,b:97,c:"line"},
  {id:"rr",n:"Respiratory rate",u:"br/min",lo:12,hi:20,b:16,c:"line"},
  {id:"temp",n:"Body temperature",u:"°F",lo:97,hi:99.5,b:98.3,c:"line",d:1},
  {id:"wt",n:"Weight",u:"lb",b:180,c:"line",d:1},
  {id:"glu",n:"Blood glucose",u:"mg/dL",lo:70,hi:140,b:104,c:"line"},
  {id:"water",n:"Water intake",u:"oz",lo:40,hi:200,b:58,c:"bar",goal:64},
  {id:"sleep",n:"Sleep duration",u:"hrs",lo:6,hi:10,b:6.8,c:"bar",goal:8,d:1},
  {id:"act",n:"Physical activity",u:"min",lo:15,hi:300,b:34,c:"bar",goal:30},
  {id:"steps",n:"Steps",u:"steps",lo:3000,hi:30000,b:6200,c:"bar",goal:8000}
];

const MM=Object.fromEntries(M.map(m=>[m.id,m]));
const CH={line:"Line",bar:"Bar",area:"Area",progress:"Progress",number:"Number"};

const PT=[
  {
    id:"p1",f:"Maya",l:"Okafor",age:58,
    dx:["Hypertension","Type 2 diabetes"],
    bias:{bp:14,glu:32},dr:{bp:10,glu:8}
  },
  {
    id:"p2",f:"Daniel",l:"Reyes",age:67,dx:["COPD"],
    bias:{spo2:-4,rr:3},dr:{spo2:-1.5,rr:2}
  },
  {
    id:"p3",f:"Priya",l:"Raman",age:44,dx:["Hypothyroidism"],
    bias:{wt:-20},dr:{wt:-1}
  },
  {
    id:"p4",f:"Samuel",l:"Whitfield",age:72,dx:["Atrial fibrillation"],
    bias:{hr:12,act:-14},dr:{hr:9}
  },
  {
    id:"p5",f:"Lena",l:"Hoffmann",age:35,dx:["Asthma"],
    bias:{steps:3000,wt:-35},dr:{}
  },
  {
    id:"p6",f:"Tomás",l:"Ibarra",age:51,dx:["Prediabetes"],
    bias:{glu:22,wt:25},dr:{glu:-14,wt:-4}
  }
];

const SPEC={
  gp:["General practice",["hr","bp","spo2","wt","glu","steps","sleep"]],
  card:["Cardiology",["hr","bp","spo2","act","wt","steps"]],
  pulm:["Pulmonology",["spo2","rr","hr","temp","act"]],
  neuro:["Neurology",["hr","bp","sleep","act","steps"]],
  endo:["Endocrinology",["glu","wt","water","act","steps","sleep"]]
};

function rng(seed){
  return ()=>((seed=seed*16807%2147483647)/2147483647);
}
const D={};
PT.forEach((p,pi)=>{
  D[p.id]={};
  M.forEach((m,mi)=>{
    const random=rng(pi*97+mi*13+11);
    D[p.id][m.id]=Array.from({length:365},(_,i)=>{
      const j=i-335;
      let v=m.b+
        (p.bias[m.id]||0)*(j<0?.6+.4*i/335:1)+
        (p.dr[m.id]||0)*Math.max(j,0)/29+
        (random()-.5)*(m.id==="temp"?.7:m.b*.08)+
        Math.sin(i/58)*m.b*.01;
      if(m.id==="spo2")v=Math.min(100,v);
      if(m.id==="sleep")v=Math.min(24,v);
      return +Math.max(0,v).toFixed(m.d||0);
    });
  });
});

const patient=id=>PT.find(p=>p.id===id);
const fullName=p=>p.f+" "+p.l;
const initials=p=>p.f[0]+p.l[0];
const avg=a=>a.reduce((sum,v)=>sum+v,0)/(a.length||1);
const current=(pid,id)=>D[pid][id].at(-1);
const isOut=(v,m)=>m.lo!=null&&(v<m.lo||v>m.hi);
const flagged=pid=>M.filter(m=>isOut(current(pid,m.id),m));
const metricName=m=>m.id==="bp"?"Systolic blood pressure":m.n;

function date(offset=0){
  const d=new Date(END+"T12:00:00Z");
  d.setUTCDate(d.getUTCDate()+offset);
  return d;
}
const parseDate=s=>new Date(s+"T12:00:00Z");
const iso=d=>d.toISOString().slice(0,10);
function shift(s,n){
  const d=parseDate(s);
  d.setUTCDate(d.getUTCDate()+n);
  return iso(d);
}
function monday(s){
  return shift(s,-((parseDate(s).getUTCDay()+6)%7));
}
function dateLabel(d,year=false){
  return d.toLocaleDateString("en-US",{
    month:"short",day:"numeric",
    ...(year?{year:"numeric"}:{}),timeZone:"UTC"
  });
}
function fmt(v,m,extra=false){
  const decimals=extra?Math.max(1,m.d||0):m.d||0;
  return Number(v).toLocaleString("en-US",{
    minimumFractionDigits:decimals,maximumFractionDigits:decimals
  });
}
function target(m){
  return m.lo==null?"No target configured":
    `${m.lo}–${m.hi} ${m.u}${m.id==="bp"?" (systolic)":""}`;
}
function readStorage(key,fallback=null){
  try{return JSON.parse(localStorage.getItem(key))??fallback}
  catch{return fallback}
}
function writeStorage(key,value){
  try{
    localStorage.setItem(key,JSON.stringify(value));
    return true;
  }catch{return false}
}

/* ---------- App state and preferences ---------- */
function defaults(){
  return {
    on:Object.fromEntries(M.map(m=>[
      m.id,["hr","bp","spo2","wt","steps"].includes(m.id)
    ])),
    chart:Object.fromEntries(M.map(m=>[m.id,m.c])),
    order:M.map(m=>m.id),
    range:14,layout:"grid",alerts:true,
