  return `
    <div class="grid ${getSetting(sc,"layout")==="list"?"list":""}">
      ${ids.map(id=>{
        const m=MM[id];
        const values=D[pid][id].slice(-days);
        const latest=values.at(-1);
        const delta=latest-values.at(-2);
        const stable=Math.abs(delta)/Math.max(1,Math.abs(values.at(-2)))<.015;

        return `
          <article class="card metric-card ${isOut(latest,m)?"out":""}">
            <div class="row">
              ${previewOnly?`<b>${m.n}</b>`:`
                <button class="title" data-action="metric" data-id="${id}">
                  ${m.n}
                </button>`}
              <span class="sp"></span>
              ${statusChip(pid,id)}
            </div>
            <div style="margin-top:12px">
