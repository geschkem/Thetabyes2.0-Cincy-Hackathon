  else $("login-error").textContent="Check the demo name and password.";
});

const deviceKey=id=>"smart-clinic-complete-device:"+id;
const encode=buffer=>btoa(String.fromCharCode(...new Uint8Array(buffer)));
const decode=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
const challenge=()=>crypto.getRandomValues(new Uint8Array(32));

function deviceAvailable(){
  return window.isSecureContext&&
    (location.protocol==="https:"||
      ["localhost","127.0.0.1"].includes(location.hostname))&&
    Boolean(window.PublicKeyCredential&&navigator.credentials);
}
async function deviceAction(register=false){
  if(busy)return;
  const tell=message=>{
    if(provider)announce(message);
    else $("login-error").textContent=message;
  };

  if(!deviceAvailable()){
    tell("Device unlock requires HTTPS or localhost. For a local HTML file, use the demo password.");
    return;
  }

  const p=register?provider:PROVIDERS.find(p=>
    p.name.toLowerCase()===
      $("username").value.trim().replace(/\s+/g," ").toLowerCase()
  );
  if(!p){
    tell("Enter your demo first and last name.");
    return;
  }

  const saved=readStorage(deviceKey(p.id));
  if(!register&&!saved?.id){
    tell("Sign in with the demo password, then register your device in Settings.");
    return;
  }

  busy=true;
  try{
    if(register){
      const credential=await navigator.credentials.create({
        publicKey:{
          challenge:challenge(),
          rp:{name:"SMART@Clinic demo"},
          user:{
            id:new TextEncoder().encode(p.id),
            name:p.name,displayName:p.name
          },
          pubKeyCredParams:[
            {type:"public-key",alg:-7},
            {type:"public-key",alg:-257}
          ],
          authenticatorSelection:{
            authenticatorAttachment:"platform",userVerification:"required"
          },
          timeout:60000,attestation:"none"
        }
      });
      if(!credential)throw new Error("Registration canceled.");
      tell(writeStorage(deviceKey(p.id),{id:encode(credential.rawId)})
        ?"Device registered for this demo. Sign out to try it."
        :"Credential created, but browser storage is unavailable.");
    }else{
      const credential=await navigator.credentials.get({
        publicKey:{
          challenge:challenge(),
          allowCredentials:[{type:"public-key",id:decode(saved.id)}],
          userVerification:"required",timeout:60000
        }
      });
      if(!credential||encode(credential.rawId)!==saved.id){
        throw new Error("Credential did not match.");
      }
      signIn(p);
    }
  }catch(error){
    tell(error.name==="NotAllowedError"
      ?"Device prompt canceled or unavailable. Use the demo password."
      :error.message);
  }finally{
    busy=false;
  }
}
$("unlock").addEventListener("click",()=>deviceAction(false));

