
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>SMART@Clinic</title>
<style>
:root{
  --bg:#fff;--card:#fff;--ink:#132c3b;--mut:#426478;
  --line:#d4e9e9;--acc:#087e88;--tint:#eaf8f6;
  --good:#1d7a4d;--bad:#b3261e;--warn:#a85d00;
}
:root[data-theme="dark"]{
  --bg:#0f1b20;--card:#172a31;--ink:#e8f1f3;--mut:#9ab2bb;
  --line:#2a444d;--tint:#1d3640;--good:#5fd39a;
  --bad:#ff8a80;--warn:#f0b05a;
}
@media(prefers-color-scheme:dark){
  :root[data-theme="system"]{
    --bg:#0f1b20;--card:#172a31;--ink:#e8f1f3;--mut:#9ab2bb;
    --line:#2a444d;--tint:#1d3640;--good:#5fd39a;
    --bad:#ff8a80;--warn:#f0b05a;
  }
}
:root[data-hc="true"]{--line:var(--ink);--mut:var(--ink)}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{
  margin:0;background:var(--bg);color:var(--ink);
  font-family:"Avenir Next",Avenir,"Trebuchet MS",Arial,sans-serif;
  line-height:1.55;
}
button,input,select,textarea{font:inherit;color:inherit}
button,select,input,textarea{
  border:1px solid var(--line);border-radius:5px;
  background:var(--card);padding:9px 12px;
}
button{cursor:pointer;font-weight:600}
button:hover{background:var(--tint)}
button:disabled{opacity:.45;cursor:not-allowed}
:focus-visible{outline:3px solid var(--acc);outline-offset:3px}
input[type=checkbox]{width:18px;height:18px;accent-color:var(--acc);padding:0}
textarea{width:100%;min-height:120px;resize:vertical}
.primary{background:var(--acc);color:#fff;border-color:var(--acc)}
.primary:hover{background:var(--acc);filter:brightness(.94)}
.link{border:0;background:none;padding:0;color:var(--acc);text-decoration:underline}
h1{font-size:1.9rem;line-height:1.2;letter-spacing:-.6px;margin:0 0 12px}
h2{font-size:1.15rem;margin:0 0 12px}
h3{font-size:1rem;margin:0 0 8px}
p{margin:10px 0}
.row{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.sp{flex:1}
.stack{display:grid;gap:18px}
.muted,.note{color:var(--mut)}
.note{font-size:.8rem}
.good{color:var(--good)}.bad{color:var(--bad)}.warn{color:var(--warn)}
.brand{font-size:1.9rem;font-weight:800;letter-spacing:-1px;border:0;padding:0;background:none}
.brand span{color:var(--acc)}
.login{
  width:min(470px,calc(100% - 32px));margin:50px auto;padding:32px;
  border:1px solid var(--line);border-top:3px solid var(--acc);border-radius:7px;
}
.login h1{font-size:1.7rem;margin-top:28px}
.field{margin:18px 0}
.field label{display:block;font-size:.8rem;font-weight:700;margin-bottom:6px}
.field input{width:100%}
.login details{margin-top:22px;padding-top:16px;border-top:1px solid var(--line)}
.account{padding:10px 0;border-bottom:1px solid var(--line)}
.error{color:var(--bad);min-height:22px;font-size:.85rem}
header{
  padding:24px max(24px,calc((100vw - 1220px)/2));
  border-bottom:2px solid var(--acc);background:var(--card);
}
nav{position:sticky;top:0;z-index:20;background:var(--card);border-bottom:1px solid var(--line)}
.nav-inner{max-width:1220px;margin:auto;display:flex;gap:8px;overflow:auto;padding:0 24px}
nav button{
  border:0;border-bottom:2px solid transparent;border-radius:0;
  padding:14px;white-space:nowrap;color:var(--mut);
}
nav button.on{color:var(--acc);border-bottom-color:var(--acc);background:var(--tint)}
main{max-width:1220px;margin:auto;padding:28px 24px}
.welcome{padding:5px 0 25px}
.date{font-size:.75rem;letter-spacing:1px;color:var(--acc);font-weight:700;margin-bottom:12px}
.panel,.card{
  background:var(--card);border:1px solid var(--line);
  border-radius:7px;padding:22px;min-width:0;
}
.home-grid,.two{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;align-items:start}
.patient-panel{border-top:3px solid var(--acc)}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.grid.list{grid-template-columns:1fr}
.m{position:relative;cursor:pointer}
.m.out{border:2px solid var(--bad)}
.title{
  border:0;background:none;padding:0;text-align:left;font-size:.9rem;
}
.title:hover{text-decoration:underline}
.big{font-size:2rem;color:var(--acc);font-weight:750;letter-spacing:-.5px}
.unit{font-size:.85rem;color:var(--mut)}
.chip{
  display:inline-flex;gap:4px;align-items:center;border-radius:99px;
  padding:2px 10px;font-size:.8rem;font-weight:600;
  background:var(--tint);border:1px solid var(--line);
}
.m svg{width:100%;height:70px;margin:10px 0}
.card-controls{margin-top:14px;padding-top:12px;border-top:1px solid var(--line)}
.card-controls select{font-size:.8rem;padding:5px 7px;max-width:145px}
.tip{position:relative;cursor:help}
.tipbox{
  display:none;position:absolute;right:0;top:calc(100% + 6px);
  z-index:15;width:min(310px,78vw);padding:12px 14px;
  background:var(--ink);color:var(--card);border-radius:10px;
  font-size:.8rem;font-weight:500;line-height:1.5;
  box-shadow:0 6px 18px #0003;cursor:default;
}
.tipbox:before{content:"";position:absolute;top:-8px;left:0;right:0;height:8px}
.tip:not([data-dismissed]):hover>.tipbox,
.tip:not([data-dismissed]):focus>.tipbox{display:block}
.tipbox strong{display:block;margin-bottom:5px}
.tipbox small{display:block;margin-top:8px}
.av{
  display:grid;place-items:center;width:46px;height:46px;flex:none;
  background:var(--tint);color:var(--acc);border-radius:50%;font-weight:700;
}
.patient-row{
  width:100%;text-align:left;display:flex;gap:12px;align-items:center;
  flex-wrap:wrap;padding:15px 0;border:0;border-bottom:1px solid var(--line);
  border-radius:0;
}
.tabs{display:flex;gap:6px;border-bottom:1px solid var(--line);margin:18px 0;flex-wrap:wrap}
.tabs button{border:0;border-bottom:2px solid transparent;border-radius:0}
.tabs button.on{border-color:var(--acc);color:var(--acc)}
.sr{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:12px 0;border-bottom:1px solid var(--line)}
.sr .nm{flex:1;min-width:130px}
.sr select{max-width:135px;padding:5px}
.badge{font-size:.7rem;border:1px solid var(--line);padding:2px 6px;border-radius:4px}
.lab{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:16px 0}
.preview .grid{grid-template-columns:1fr}
.preview .big{font-size:1.3rem}
.preview .m{cursor:default;padding:14px}
.notice{background:var(--tint);border:1px solid var(--line);border-radius:5px;padding:13px;font-size:.8rem}
.pb{height:12px;background:var(--tint);border-radius:9px;overflow:hidden;margin-top:12px}
.pb b{display:block;background:var(--acc);height:100%}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat{font-size:1.3rem;font-weight:700;margin-top:5px}
.chart-scroll{overflow:auto}
.detail-chart{display:block;width:100%;min-width:650px}
.readout{padding:12px;background:var(--tint);border-radius:5px;font-size:.85rem;min-height:46px}
.slider{display:flex;align-items:center;gap:10px;margin-top:12px;font-size:.8rem}
.slider input{flex:1;accent-color:var(--acc);padding:0;min-width:100px}
.legend{display:flex;gap:15px;flex-wrap:wrap;margin-top:12px;font-size:.75rem;color:var(--mut)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.key{width:23px;border-top:3px solid var(--acc)}
.key.avg{border-color:var(--ink);border-top-style:dashed}
.key.pred{border-color:var(--warn);border-top-style:dotted}
.key.band{height:12px;border:0;background:var(--warn);opacity:.25}
.key.target{height:12px;border:0;background:var(--good);opacity:.25}
table{border-collapse:collapse;width:100%;font-size:.8rem}
th,td{text-align:left;padding:10px;border-bottom:1px solid var(--line)}
th{background:var(--tint)}
summary{cursor:pointer}
.event{display:block;width:100%;text-align:left;margin:10px 0;background:var(--tint);border-left:3px solid var(--acc)}
.week{display:grid;grid-template-columns:repeat(7,minmax(145px,1fr));min-width:1015px}
.day{padding:14px;border-right:1px solid var(--line);min-height:220px}
.day:last-child{border:0}
.today{background:var(--tint)}
.note-entry{padding:12px 0;border-top:1px solid var(--line)}
.note-entry p{white-space:pre-wrap}
footer{font-size:.75rem;color:var(--mut);border-top:1px solid var(--line);margin-top:28px;padding-top:18px}
@media(max-width:850px){.home-grid,.two{grid-template-columns:1fr}}
@media(max-width:600px){
  header{padding:20px 16px}main{padding:22px 16px}
  .nav-inner{padding:0 8px}.grid{grid-template-columns:1fr}
  .panel,.card{padding:17px}.login{padding:25px;margin:30px auto}
  .brand{font-size:1.6rem}
}
</style>
</head>
<body>
<section id="login" class="login">
  <div class="brand">SMART<span>@</span>Clinic</div>
  <h1>Provider sign-in</h1>
  <p class="muted">Your patients, your schedule, your workspace.</p>
  <form id="login-form">
    <div class="field">
      <label for="username">First and last name</label>
      <input id="username" placeholder="Avery Patel" autocomplete="username" required>
    </div>
    <div class="field">
      <label for="password">Demo password</label>
      <input id="password" type="password" autocomplete="off" required>
    </div>
    <p id="login-error" class="error" role="alert"></p>
    <button class="primary" style="width:100%">Sign in</button>
  </form>
  <button id="unlock" style="width:100%;margin-top:10px">Use device unlock</button>
  <p class="note" style="margin-top:16px">
    Fictional demonstration only. Do not enter a real password.
    This browser-only prototype is not secure clinical authentication.
  </p>
  <details>
    <summary class="note">Demo accounts</summary>
    <div class="account note"><b>Avery Patel</b> · Pulmonology<br>Password: <code>AveryDemo!26</code></div>
    <div class="account note"><b>Morgan Lee</b> · Neurology<br>Password: <code>MorganDemo!26</code></div>
    <div class="account note"><b>Riley Chen</b> · Endocrinology<br>Password: <code>RileyDemo!26</code></div>
    <p class="note">Device unlock requires HTTPS or localhost and registration after password sign-in.</p>
  </details>
</section>
<div id="workspace" hidden></div>

<script>
"use strict";
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
}[c]));
const END="2026-11-06",DAY=86400000;
const PROVIDERS=[
  {id:"avery",name:"Avery Patel",password:"AveryDemo!26",specialty:"Pulmonology",spec:"pulm",patients:["p2","p4","p5"]},
  {id:"morgan",name:"Morgan Lee",password:"MorganDemo!26",specialty:"Neurology",spec:"gp",patients:["p3","p4","p5"]},
  {id:"riley",name:"Riley Chen",password:"RileyDemo!26",specialty:"Endocrinology",spec:"endo",patients:["p1","p3","p6"]}
];
const M=[
  {id:"hr",n:"Heart rate",u:"bpm",lo:55,hi:100,b:72,c:"line"},
  {id:"bp",n:"Blood pressure",u:"mmHg",lo:90,hi:130,b:122,c:"line"},
  {id:"spo2",n:"Oxygen saturation",u:"%",lo:94,hi:100,b:97,c:"line"},
  {id:"rr",n:"Respiratory rate",u:"br/min",lo:12,hi:20,b:16,c:"line"},
  {id:"temp",n:"Body temperature",u:"°F",lo:97,hi:99.5,b:98.3,c:"line",d:1},
  {id:"wt",n:"Weight",u:"lb",b:180,c:"line",d:1},
  {id:"glu",n:"Blood glucose",u:"mg/dL",lo:70,hi:140,b:104,c:"line"},
  {id:"water",n:"Water intake",u:"oz",lo:40,hi:200,b:58,c:"bar",goal:64},
  {id:"sleep",n:"Sleep duration",u:"hrs",lo:6,hi:10,b:6.8,c:"bar",goal:8,d:1},
  {id:"act",n:"Physical activity",u:"min",lo:15,hi:300,b:34,c:"bar",goal:30},
  {id:"steps",n:"Steps",u:"steps",lo:3000,hi:30000,b:6200,c:"bar",goal:8000}
];
const MM=Object.fromEntries(M.map(m=>[m.id,m]));
const PT=[
  {id:"p1",f:"Maya",l:"Okafor",age:58,dx:["Hypertension","Type 2 diabetes"],bias:{bp:14,glu:32},dr:{bp:10,glu:8}},
  {id:"p2",f:"Daniel",l:"Reyes",age:67,dx:["COPD"],bias:{spo2:-4,rr:3},dr:{spo2:-1.5,rr:2}},
  {id:"p3",f:"Priya",l:"Raman",age:44,dx:["Hypothyroidism"],bias:{wt:-20},dr:{wt:-1}},
  {id:"p4",f:"Samuel",l:"Whitfield",age:72,dx:["Atrial fibrillation"],bias:{hr:12,act:-14},dr:{hr:9}},
  {id:"p5",f:"Lena",l:"Hoffmann",age:35,dx:["Asthma"],bias:{steps:3000,wt:-35},dr:{}},
  {id:"p6",f:"Tomás",l:"Ibarra",age:51,dx:["Prediabetes"],bias:{glu:22,wt:25},dr:{glu:-14,wt:-4}}
];
const CH={line:"Line",bar:"Bar",area:"Area",progress:"Progress",number:"Number"};
const SPEC={
  gp:["General practice",["hr","bp","spo2","wt","glu","steps","sleep"]],
  card:["Cardiology",["hr","bp","spo2","act","wt","steps"]],
  pulm:["Pulmonology",["spo2","rr","hr","temp","act"]],
  endo:["Endocrinology",["glu","wt","water","act","steps","sleep"]]
};
function rng(s){return()=>(s=s*16807%2147483647)/2147483647}
const D={};
PT.forEach((p,pi)=>{
  D[p.id]={};
  M.forEach((m,mi)=>{
    const r=rng(pi*97+mi*13+11);
    D[p.id][m.id]=Array.from({length:365},(_,i)=>{
      const j=i-335;
      let v=m.b+(p.bias[m.id]||0)*(j<0?.6+.4*i/335:1)+
        (p.dr[m.id]||0)*Math.max(j,0)/29+
        (r()-.5)*(m.id==="temp"?.7:m.b*.08)+Math.sin(i/58)*m.b*.01;
      if(m.id==="spo2")v=Math.min(100,v);
      if(m.id==="sleep")v=Math.min(24,v);
      return +Math.max(0,v).toFixed(m.d||0);
    });
  });
});
function read(k,fallback=null){
  try{return JSON.parse(localStorage.getItem(k))??fallback}catch{return fallback}
}
function store(k,v){
  try{localStorage.setItem(k,JSON.stringify(v));return true}catch{return false}
}
const defaults=()=>({
  on:Object.fromEntries(M.map(m=>[m.id,["hr","bp","spo2","wt","steps"].includes(m.id)])),
  chart:Object.fromEntries(M.map(m=>[m.id,m.c])),order:M.map(m=>m.id),
  range:14,layout:"grid",alerts:true,theme:"light",accent:"#087e88",text:14,hc:false,spec:"gp"
});
let provider=null,S=null,V={page:"home"},patientTab="dash",settingsTab="dash";
let preview="",sort="last",range="month",detailType="line",showAvg=true,showPred=true;
let chartState=null,tipId=0,backScroll=0,busy=false;
let calDate=END,calMode="week",notes=[],drafts={};
const patient=id=>PT.find(p=>p.id===id);
const name=p=>p.f+" "+p.l;
const ini=p=>p.f[0]+p.l[0];
const roster=()=>provider.patients.map(patient);
const avg=a=>a.reduce((s,v)=>s+v,0)/(a.length||1);
const cur=(pid,id)=>D[pid][id].at(-1);
const out=(v,m)=>m.lo!=null&&(v<m.lo||v>m.hi);
const outs=pid=>M.filter(m=>out(cur(pid,m.id),m));
const key=()=> "smart-clinic-merged-v1:"+provider.id;
const scope=()=>V.pid||"g";
function date(offset=0){
  const d=new Date(END+"T12:00:00Z");d.setUTCDate(d.getUTCDate()+offset);return d;
}
const parse=s=>new Date(s+"T12:00:00Z");
const iso=d=>d.toISOString().slice(0,10);
function shift(s,n){const d=parse(s);d.setUTCDate(d.getUTCDate()+n);return iso(d)}
function monday(s){return shift(s,-((parse(s).getUTCDay()+6)%7))}
function label(d,year=false){
  return d.toLocaleDateString("en-US",{month:"short",day:"numeric",
    ...(year?{year:"numeric"}:{}),timeZone:"UTC"});
}
function fmt(v,m,extra=false){
  const d=extra?Math.max(1,m.d||0):m.d||0;
  return Number(v).toLocaleString("en-US",{minimumFractionDigits:d,maximumFractionDigits:d});
}
function save(){return store(key(),S)}
function O(sc){S.p[sc]||={on:{},chart:{}};S.p[sc].on||={};S.p[sc].chart||={};return S.p[sc]}
function get(sc,k,id){
  const o=sc==="g"?S.g:O(sc);
  return id==null?(o[k]!==undefined?o[k]:S.g[k]):
    (o[k]&&id in o[k]?o[k][id]:S.g[k][id]);
}
function put(sc,k,id,v){
  const o=sc==="g"?S.g:O(sc);
  if(id==null)o[k]=v;else{o[k]||={};o[k][id]=v}
}
function customized(sc,k,id){
  return sc!=="g"&&(id==null?O(sc)[k]!==undefined:id in O(sc)[k]);
}
function order(sc){
  const ids=[...new Set([...(get(sc,"order")||[]).filter(id=>MM[id]),...M.map(m=>m.id)])];
  return [...ids.filter(id=>get(sc,"on",id)),...ids.filter(id=>!get(sc,"on",id))];
}
const target=m=>m.lo==null?"No target configured":
  `${m.lo}–${m.hi} ${m.u}${m.id==="bp"?" (systolic)":""}`;
function announce(text){if($("status"))$("status").textContent=text}

function signIn(p){
  provider=p;
  const base=defaults(),saved=read(key(),{});
  S={g:{...base,...saved.g,on:{...base.on,...saved.g?.on},
    chart:{...base.chart,...saved.g?.chart}},p:saved.p||{}};
  if(!saved.g)S.g.spec=p.spec;
  preview=p.patients[0];V={page:"home"};notes=[];drafts={};
  settingsTab="dash";patientTab="dash";
  $("password").value="";$("login-error").textContent="";
  $("login").hidden=true;$("workspace").hidden=false;
  render();window.scrollTo(0,0);
}
function signOut(){
  if(busy)return;
  if((notes.length||Object.values(drafts).some(Boolean))&&
    !confirm("Sign out? Session notes and drafts will be discarded."))return;
  provider=null;S=null;notes=[];drafts={};chartState=null;
  $("workspace").replaceChildren();$("workspace").hidden=true;$("login").hidden=false;
  document.documentElement.dataset.theme="light";
  $("password").value="";$("username").focus();
}
$("login-form").addEventListener("submit",e=>{
  e.preventDefault();if(busy)return;
  const n=$("username").value.trim().replace(/\s+/g," ").toLowerCase();
  const p=PROVIDERS.find(p=>p.name.toLowerCase()===n&&p.password===$("password").value);
  if(p)signIn(p);else $("login-error").textContent="Check the demo name and password.";
});

/* Device prompt demonstration only: no server verifies assertions. */
const deviceKey=id=>"smart-clinic-merged-device:"+id;
const encode=b=>btoa(String.fromCharCode(...new Uint8Array(b)));
const decode=s=>Uint8Array.from(atob(s),c=>c.charCodeAt(0));
const challenge=()=>crypto.getRandomValues(new Uint8Array(32));
function deviceAvailable(){
  return isSecureContext&&(location.protocol==="https:"||
    ["localhost","127.0.0.1"].includes(location.hostname))&&
    Boolean(window.PublicKeyCredential&&navigator.credentials);
}
async function deviceAction(register=false){
  if(busy)return;
  if(!deviceAvailable()){
    const message="Device unlock requires HTTPS or localhost. Use the demo password for a local HTML file.";
    if(provider)announce(message);else $("login-error").textContent=message;
    return;
  }
  const p=register?provider:PROVIDERS.find(p=>
    p.name.toLowerCase()===$("username").value.trim().replace(/\s+/g," ").toLowerCase());
  if(!p){$("login-error").textContent="Enter your demo first and last name.";return}
  const saved=read(deviceKey(p.id));
  if(!register&&!saved?.id){
    $("login-error").textContent="Sign in with the demo password, then register your device in Global Settings.";
    return;
  }
  busy=true;
  try{
    if(register){
      const c=await navigator.credentials.create({publicKey:{
        challenge:challenge(),rp:{name:"SMART@Clinic demo"},
        user:{id:new TextEncoder().encode(p.id),name:p.name,displayName:p.name},
        pubKeyCredParams:[{type:"public-key",alg:-7},{type:"public-key",alg:-257}],
        authenticatorSelection:{authenticatorAttachment:"platform",userVerification:"required"},
        timeout:60000,attestation:"none"
      }});
      if(!c)throw new Error("Registration canceled.");
      announce(store(deviceKey(p.id),{id:encode(c.rawId)})?
        "Device registered for this demo. Sign out to try device unlock.":
        "Credential created, but browser storage is unavailable.");
    }else{
      const c=await navigator.credentials.get({publicKey:{
        challenge:challenge(),allowCredentials:[{type:"public-key",id:decode(saved.id)}],
        userVerification:"required",timeout:60000
      }});
      if(!c||encode(c.rawId)!==saved.id)throw new Error("Credential did not match.");
      signIn(p);
    }
  }catch(e){
    const msg=e.name==="NotAllowedError"?"Device prompt canceled or unavailable. Use the demo password.":e.message;
    if(provider)announce(msg);else $("login-error").textContent=msg;
  }finally{busy=false}
}
$("unlock").onclick=()=>deviceAction(false);

function bubble(pid,id){
  const m=MM[id],v=cur(pid,id);
  if(m.lo==null)return "";
  if(!out(v,m))return '<span class="chip good">✓ In range</span>';
  const below=v<m.lo,diff=Math.abs(v-(below?m.lo:m.hi));
  const count=D[pid][id].slice(-7).filter(v=>out(v,m)).length;
  const tid="tip-"+(++tipId);
  return `<span class="chip bad tip" tabindex="0" aria-describedby="${tid}">
    ⚠ Out of range
    <span class="tipbox" id="${tid}" role="tooltip">
      <strong>Why this reading is flagged</strong>
      ${name(patient(pid))}’s latest ${id==="bp"?"systolic blood pressure":m.n.toLowerCase()}
      is ${fmt(v,m)} ${m.u}: ${fmt(diff,m)} ${m.u}
      ${below?"below the lower":"above the upper"} limit of ${target(m)}.
      ${count} of the last 7 daily readings were outside this range.
      <small>Shared demo targets—not individualized clinical thresholds.
      This explains the flag, not its medical cause.</small>
    </span></span>`;
}
function trend(v){
  const d=v.at(-1)-v.at(-2),stable=Math.abs(d)/Math.max(1,Math.abs(v.at(-2)))<.015;
  return `<span class="note">${stable?"→ Stable":d>0?"↑ Rising":"↓ Falling"} since previous reading</span>`;
}
function spark(v,m,type){
  if(type==="number")return "";
  if(type==="progress"){
    if(!m.goal)return `<p class="note">${target(m)} · No progress goal set</p>`;
    const pct=v.at(-1)/m.goal*100;
    return `<div class="pb" role="progressbar" aria-label="${m.n} goal"
      aria-valuemin="0" aria-valuemax="100" aria-valuenow="${Math.min(100,Math.round(pct))}">
      <b style="width:${Math.max(0,Math.min(100,pct))}%"></b></div>
      <div class="note">${Math.round(pct)}% of ${m.goal} ${m.u} goal</div>`;
  }
  const W=300,H=70,min=Math.min(...v),max=Math.max(...v);
  const X=i=>i*W/Math.max(1,v.length-1),Y=x=>H-5-(x-min)/(max-min||1)*(H-12);
  const pts=v.map((x,i)=>`${X(i)},${Y(x)}`).join(" ");
  const drawing=type==="bar"?v.map((x,i)=>{
    const w=W/v.length,h=Math.max(2,x/Math.max(1,max)*(H-5));
    return `<rect x="${i*w+w*.15}" y="${H-h}" width="${w*.7}" height="${h}" fill="var(--acc)"/>`;
  }).join(""):`${type==="area"?`<polygon points="0,${H} ${pts} ${W},${H}" fill="var(--acc)" opacity=".15"/>`:""}
    <polyline points="${pts}" fill="none" stroke="var(--acc)" stroke-width="2.5"/>`;
  return `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${m.n} recent trend">${drawing}</svg>`;
}
