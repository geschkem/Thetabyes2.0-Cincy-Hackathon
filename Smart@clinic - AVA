function selectedPeriod(){
  let start=date();
  if(range==="week"){
    start.setUTCDate(start.getUTCDate()-((start.getUTCDay()+6)%7));
  }else if(range==="month"){
    start.setUTCDate(1);
  }else{
    start=date(range==="six"?-181:-364);
  }
  return {
    start,
    n:Math.round((date()-start)/DAY)+1,
    h:{week:7,month:14,six:30,year:60}[range]
  };
}

function fitModel(values,h){
  const n=values.length,mean=avg(values),mid=(n-1)/2;
  let xx=0,xy=0,total=0;
  values.forEach((v,i)=>{
    xx+=(i-mid)**2;
    xy+=(i-mid)*(v-mean);
    total+=(v-mean)**2;
  });
  const slope=xx?xy/xx:0;
  const intercept=mean-slope*mid;
  const error=values.reduce((s,v,i)=>
    s+(v-intercept-slope*i)**2,0);
  const residual=Math.sqrt(error/Math.max(1,n-2));

  const predictions=Array.from({length:h},(_,k)=>{
    const i=n+k,v=intercept+slope*i;
    const width=2*residual*Math.sqrt(
      1+1/n+(xx?(i-mid)**2/xx:0)
    );
    return {v,low:v-width,high:v+width};
  });
  return {
    slope,predictions,
    r2:total?Math.max(0,1-error/total):0
  };
}

function detailedChart(values,m,fit){
  const predictions=showPred?fit.predictions:[];
  const n=values.length,total=n+predictions.length;
  const W=960,H=380,L=75,R=25,T=30,B=50;
  let lo=Math.min(...values,...predictions.map(p=>p.low));
  let hi=Math.max(...values,...predictions.map(p=>p.high));
  if(m.lo!=null){
    lo=Math.min(lo,m.lo);
    hi=Math.max(hi,m.hi);
  }
  if(detailType==="bar")lo=Math.min(0,lo);
  const pad=(hi-lo||1)*.1;
  lo-=pad;hi+=pad;

  const X=i=>L+i*(W-L-R)/Math.max(1,total-1);
  const Y=v=>T+(hi-v)/(hi-lo)*(H-T-B);
  const pts=values.map((v,i)=>`${X(i)},${Y(v)}`).join(" ");
  const mean=avg(values);

  let drawing=`
    <defs>
      <clipPath id="plotclip">
        <rect x="${L}" y="${T}" width="${W-L-R}" height="${H-T-B}"/>
      </clipPath>
    </defs>
    <text x="${L}" y="17" font-size="12" fill="var(--mut)">
      ${m.u}${m.id==="bp"?" · systolic":""}
    </text>`;

  if(m.lo!=null){
    drawing+=`
      <rect x="${L}" y="${Y(m.hi)}" width="${W-L-R}"
        height="${Y(m.lo)-Y(m.hi)}" fill="var(--good)" opacity=".1"/>`;
  }

  for(let j=0;j<=5;j++){
    const v=lo+(hi-lo)*j/5;
    drawing+=`
      <line x1="${L}" x2="${W-R}" y1="${Y(v)}" y2="${Y(v)}"
        stroke="var(--line)"/>
      <text x="${L-8}" y="${Y(v)+4}" text-anchor="end"
        font-size="11" fill="var(--mut)">${fmt(v,m)}</text>`;
  }
  for(let j=0;j<=5;j++){
    const i=Math.round((total-1)*j/5);
    drawing+=`
      <text x="${X(i)}" y="${H-15}" text-anchor="middle"
        font-size="11" fill="var(--mut)">${label(date(i-n+1))}</text>`;
  }

  drawing+='<g clip-path="url(#plotclip)">';
  if(detailType==="bar"){
    const width=Math.max(1,Math.min(20,(W-L-R)/total*.7));
    drawing+=values.map((v,i)=>`
      <rect x="${X(i)-width/2}" y="${Y(v)}" width="${width}"
        height="${Math.max(1,Y(0)-Y(v))}" fill="var(--acc)" opacity=".8"/>
    `).join("");
  }else{
    if(detailType==="area"){
      drawing+=`
        <polygon points="${X(0)},${H-B} ${pts} ${X(n-1)},${H-B}"
          fill="var(--acc)" opacity=".15"/>`;
    }
    drawing+=`
      <polyline points="${pts}" fill="none" stroke="var(--acc)"
        stroke-width="2.5" stroke-linejoin="round"/>`;
    if(n<=31){
      drawing+=values.map((v,i)=>`
        <circle cx="${X(i)}" cy="${Y(v)}" r="3" fill="var(--acc)"/>
      `).join("");
    }
  }

  if(showAvg){
    drawing+=`
      <line x1="${L}" x2="${W-R}" y1="${Y(mean)}" y2="${Y(mean)}"
        stroke="var(--ink)" stroke-dasharray="8 5"/>
      <text x="${L+8}" y="${Y(mean)-8}" font-size="12" fill="var(--ink)">
        Average ${fmt(mean,m,true)}
      </text>`;
  }

  if(predictions.length){
    const upper=predictions.map((p,k)=>`${X(n+k)},${Y(p.high)}`).join(" ");
    const lower=predictions.map((p,k)=>`${X(n+k)},${Y(p.low)}`).reverse().join(" ");
    const projected=predictions.map((p,k)=>`${X(n+k)},${Y(p.v)}`).join(" ");
    drawing+=`
      <polygon points="${upper} ${lower}" fill="var(--warn)" opacity=".16"/>
      <polyline points="${X(n-1)},${Y(values.at(-1))} ${projected}"
        fill="none" stroke="var(--warn)" stroke-width="2.5"
        stroke-dasharray="3 6"/>
      <line x1="${X(n-1)}" x2="${X(n-1)}" y1="${T}" y2="${H-B}"
        stroke="var(--mut)" stroke-dasharray="4 4"/>
      <text x="${X(n-1)+8}" y="${T+15}" font-size="12" fill="var(--warn)">
        Projection →
      </text>`;
  }

  drawing+=`
    <line id="crosshair" x1="${X(n-1)}" x2="${X(n-1)}"
      y1="${T}" y2="${H-B}" stroke="var(--ink)" opacity=".35"/>
    </g>`;

  chartState={W,L,R,n,total,m,values,predictions};

  return `
    <div class="chart-scroll">
      <svg id="detail-svg" class="detail-chart" viewBox="0 0 ${W} ${H}"
        role="img" aria-label="${m.n} history with optional average and projection">
        <title>${m.n} over the selected period</title>
        ${drawing}
      </svg>
    </div>`;
}

function metricPage(){
  const p=patient(V.pid),m=MM[V.metric],period=selectedPeriod();
  const values=D[p.id][m.id].slice(-period.n);
  const fit=fitModel(values,period.h),end=fit.predictions.at(-1);
  const delta=values.at(-1)-values[0];
  const count=values.filter(v=>out(v,m)).length;
  const impossible=fit.predictions.some(p=>
    p.v<0||(m.id==="spo2"&&p.v>100)||(m.id==="sleep"&&p.v>24)
  );

  const stat=(title,value)=>`
    <div class="panel">
      <div class="note">${title}</div>
      <div class="stat">${value}</div>
    </div>`;

  return `
    <button data-a="back">← Back to dashboard</button>
    <section class="panel row" style="margin:18px 0">
      <span class="av">${ini(p)}</span>
      <div style="flex:1">
        <h1 id="detail-heading" tabindex="-1">${m.n}</h1>
        <div class="note">${name(p)} · ${target(m)}</div>
      </div>
      <div>
        <span class="big">${fmt(values.at(-1),m)}</span>
        <span class="unit">${m.u}${m.id==="bp"?" · systolic":""}</span>
      </div>
      ${bubble(p.id,m.id)}
    </section>

    <div class="stack">
      <div class="row" role="group" aria-label="Chart period">
        ${[
          ["week","This week"],["month","This month"],
          ["six","6 months"],["year","Year"]
        ].map(([k,n])=>`
          <button class="${range===k?"primary":""}"
            data-a="period" data-id="${k}" aria-pressed="${range===k}">
            ${n}
          </button>`).join("")}
        <span class="sp"></span>
        <label class="note">Chart
          <select data-c="detail-type">
            ${["line","area","bar"].map(k=>`
              <option value="${k}" ${detailType===k?"selected":""}>
                ${k[0].toUpperCase()+k.slice(1)}
              </option>`).join("")}
          </select>
        </label>
      </div>

      <section class="panel">
        <div class="row">
          <h2 style="margin:0">Measurement history</h2>
          <span class="sp"></span>
          <label><input type="checkbox" data-c="average" ${showAvg?"checked":""}> Average</label>
          <label><input type="checkbox" data-c="prediction" ${showPred?"checked":""}> Projection</label>
        </div>
        <p class="note">
          ${label(period.start,true)} – ${label(date(),true)} ·
          ${values.length} daily sample readings.
          Week starts Monday; month is month-to-date.
          Longer views cover the last 182 or 365 days.
        </p>
        ${detailedChart(values,m,fit)}
        <div id="readout" class="readout" aria-live="polite">
          Hover over the chart, tap it, or use the slider below.
        </div>
        <label class="slider">
          Explore readings
          <input id="reading-slider" type="range" min="0"
            max="${chartState.total-1}" value="${values.length-1}"
            aria-label="Explore dated readings and projections">
        </label>
        <div class="legend">
          <span><i class="key"></i>Measurements</span>
          ${showAvg?'<span><i class="key avg"></i>Historical average</span>':""}
          ${m.lo!=null?'<span><i class="key target"></i>Configured target</span>':""}
          ${showPred?`
            <span><i class="key pred"></i>Exploratory projection</span>
            <span><i class="key band"></i>Illustrative uncertainty band</span>`:""}
        </div>
      </section>

      <div class="stats">
        ${stat("Period average",fmt(avg(values),m,true)+" "+m.u)}
        ${stat("Lowest",fmt(Math.min(...values),m)+" "+m.u)}
        ${stat("Highest",fmt(Math.max(...values),m)+" "+m.u)}
        ${stat("First-to-last change",(delta>0?"+":"")+fmt(delta,m,true)+" "+m.u)}
        ${stat("Days outside target",m.lo==null?"No target":count+" of "+values.length)}
      </div>

      <section class="panel">
        <div class="row">
          <h2>Exploratory predictive model</h2>
          <span class="badge">Demo · Not clinically validated</span>
        </div>
        <div class="two">
          <div>
            <h3>Trend-based projection</h3>
            <p>
              A straight-line model fitted to these ${values.length} readings
              changes by approximately
              <b>${fmt(fit.slope*7,m,true)} ${m.u} per week</b>.
            </p>
            <p>
              Projected value on ${label(date(period.h),true)}:
              <b>${fmt(end.v,m,true)} ${m.u}</b>.
            </p>
            <p class="note">
              Illustrative band: ${fmt(end.low,m,true)}–${fmt(end.high,m,true)}
              ${m.u}. This is not a calibrated clinical probability interval.
            </p>
          </div>
          <div>
            <h3>Model context</h3>
            <ul style="padding-left:18px">
              <li>Forecast horizon: ${period.h} days.</li>
              <li>Training history: the selected period.</li>
              <li>In-sample R²: ${fit.r2.toFixed(2)}.
                Fit does not establish forecast accuracy.</li>
              <li>No medication, diagnosis, treatment, or lifestyle inputs.</li>
              ${values.length<14?`
                <li class="warn">Short history: projections are especially unstable.</li>`:""}
            </ul>
          </div>
        </div>
        ${impossible?`
          <p class="notice warn">
            The model produces a physically implausible point forecast.
            Treat that as model failure, not a patient prediction.
          </p>`:""}
        <div class="notice">
          Synthetic data and illustrative linear extrapolation only—not a diagnosis
          or treatment recommendation. The band uses ±2 residual standard errors
          with forecast leverage. It is not validated for serially correlated
          health readings and can include impossible values. Clinical use requires
          validated models, appropriate patient-specific targets, and clinician review.
        </div>
      </section>

      <section class="panel">
        <details>
          <summary>View ${values.length} recorded measurements</summary>
          <div style="overflow:auto;max-height:340px;margin-top:12px">
            <table>
              <thead><tr><th>Date</th><th>Value</th><th>Status</th></tr></thead>
              <tbody>
                ${values.map((v,i)=>`
                  <tr>
                    <td>${label(date(i-values.length+1),true)}</td>
                    <td>${fmt(v,m)} ${m.u}</td>
                    <td class="${m.lo==null?"muted":out(v,m)?"bad":"good"}">
                      ${m.lo==null?"No target":out(v,m)?"Out of range":"In range"}
                    </td>
                  </tr>`).reverse().join("")}
              </tbody>
            </table>
          </div>
        </details>
      </section>
    </div>`;
}

function render(){
  if(!provider)return;

  const root=document.documentElement;
  root.dataset.theme=S.g.theme;
  root.dataset.hc=String(Boolean(S.g.hc));
  root.style.setProperty("--acc",S.g.accent);
  root.style.fontSize=S.g.text+"px";
  tipId=0;chartState=null;

  const content=V.page==="home"?home():
    V.page==="calendar"?calendar():
    V.page==="settings"?settings("g"):
    V.page==="metric"?metricPage():patientPage();

  const navItems=[
    ["home","Home"],["calendar","Calendar"],["settings","Global Settings"]
  ];
  if(V.pid)navItems.push(["patient","Patient chart"]);

  $("workspace").innerHTML=`
    <header class="row">
      <div>
        <button class="brand" data-a="nav" data-id="home">
          SMART<span>@</span>Clinic
        </button>
        <div class="note" style="margin-top:7px">Clinical portal · Fictional demo</div>
      </div>
      <span class="sp"></span>
      <div>
        <b>${provider.name}</b>
        <div class="note">${provider.specialty}</div>
      </div>
      <button data-a="logout">Sign out</button>
    </header>
    <nav aria-label="Provider workspace">
      <div class="nav-inner">
        ${navItems.map(([k,n])=>{
          const active=V.page===k||(k==="patient"&&V.page==="metric");
          return `<button data-a="nav" data-id="${k}"
            class="${active?"on":""}" ${active?'aria-current="page"':""}>${n}</button>`;
        }).join("")}
      </div>
    </nav>
    <main>
      ${content}
      <p id="status" class="note" role="status" aria-live="polite"></p>
      <footer>
        Synthetic measurements through November 6, 2026.
        View-only simulated appointments. No live EHR connection,
        secure clinical authentication, validated alerts, diagnoses,
        or treatment recommendations.
      </footer>
    </main>`;
}

function openPatient(id){
  if(!provider.patients.includes(id))return;
  V={page:"patient",pid:id};
  patientTab="dash";settingsTab="dash";
  render();window.scrollTo(0,0);
}

function openMetric(id){
  if(!V.pid||!MM[id])return;
  backScroll=window.scrollY;
  V={page:"metric",pid:V.pid,metric:id};
  render();window.scrollTo(0,0);
  $("detail-heading")?.focus({preventScroll:true});
}

document.addEventListener("click",event=>{
  if(!provider||busy)return;
  const button=event.target.closest("[data-a]");

  if(!button){
    const card=event.target.closest("[data-open]");
    if(card&&!event.target.closest("button,select,input,label,a,.tip")){
      openMetric(card.dataset.open);
    }
    return;
  }

  const a=button.dataset.a,id=button.dataset.id,sc=scope();

  if(a==="logout"){signOut();return}
  if(a==="register-device"){deviceAction(true);return}
  if(a==="forget-device"){
    try{
      localStorage.removeItem(deviceKey(provider.id));
      announce("Demo registration forgotten. A passkey may remain in your device password manager.");
    }catch{announce("Browser storage could not be updated.")}
    return;
  }
  if(a==="patient"){openPatient(id);return}
  if(a==="metric"){openMetric(id);return}

  if(a==="nav"){
    if(id==="patient"&&V.pid){
      V={page:"patient",pid:V.pid};patientTab="dash";
    }else{
      V={page:id};settingsTab="dash";
    }
    render();window.scrollTo(0,0);return;
  }

  if(a==="back"){
    V={page:"patient",pid:V.pid};patientTab="dash";
    render();window.scrollTo(0,backScroll);return;
  }
  if(a==="save-note"){
    const text=$("note-text").value.trim();
    if(!text){announce("Write a fictional note first.");return}
    if(!$("review-note").checked){
      announce("Review the note and check the accuracy confirmation.");return;
    }
    notes.push({
      pid:V.pid,author:provider.name,
      time:new Date().toLocaleString(),text
    });
    drafts[V.pid]="";
    $("note-text").value="";$("review-note").checked=false;
    $("notes").innerHTML=notesHTML(V.pid);
    announce("Reviewed note saved for this session.");
    return;
  }

  if(a==="patient-tab"){
    patientTab=id;settingsTab="dash";
  }else if(a==="settings-tab"){
    settingsTab=id;
  }else if(a==="period"){
    range=id;
  }else if(a==="cal-mode"){
    calMode=id;
  }else if(a==="cal-today"){
    calDate=END;
  }else if(a==="cal-shift"){
    calDate=shift(calDate,Number(id)*(calMode==="week"?7:1));
  }else if(a==="reset-patient"){
    if(!confirm("Reset this patient's display settings to provider defaults?"))return;
    S.p[sc]={on:{},chart:{}};
  }else if(a==="reset-metric"){
    delete O(sc).on[id];delete O(sc).chart[id];
  }else if(a==="move"){
    const ids=order(sc),i=ids.indexOf(id),j=i+Number(button.dataset.d);
    if(j>=0&&j<ids.length){
      [ids[i],ids[j]]=[ids[j],ids[i]];
      put(sc,"order",null,ids);
    }
  }else if(a==="preset"){
    if(!confirm("Apply this preset to provider-wide display settings?"))return;
    const ids=SPEC[S.g.spec][1];
    M.forEach(m=>S.g.on[m.id]=ids.includes(m.id));
    S.g.order=[...ids,...M.map(m=>m.id).filter(id=>!ids.includes(id))];
  }
  save();render();
});

document.addEventListener("change",event=>{
  if(!provider||busy)return;
  const t=event.target,k=t.dataset.c;
  if(!k)return;
  const sc=scope(),id=t.dataset.id;

  if(k==="patient"){openPatient(t.value);return}
  if(k==="sort")sort=t.value;
  else if(k==="preview")preview=t.value;
  else if(k==="on")put(sc,"on",id,t.checked);
  else if(k==="chart")put(sc,"chart",id,t.value);
  else if(k==="range")put(sc,"range",null,Number(t.value));
  else if(k==="layout")put(sc,"layout",null,t.value);
  else if(k==="alerts")put(sc,"alerts",null,t.checked);
  else if(k==="detail-type")detailType=t.value;
  else if(k==="average")showAvg=t.checked;
  else if(k==="prediction")showPred=t.checked;
  else if(k==="cal-date"){
    if(t.value)calDate=t.value;
  }else if(k==="hc")S.g.hc=t.checked;
  else if(k==="text")S.g.text=Number(t.value);
  else if(["theme","accent","spec"].includes(k))S.g[k]=t.value;

  save();render();
});

function showReading(index){
  const c=chartState;
  if(!c)return;
  index=Math.max(0,Math.min(c.total-1,Math.round(index)));
  const projected=index>=c.n;
  const p=projected?c.predictions[index-c.n]:null;
  const value=projected?p.v:c.values[index];
  const text=`${label(date(index-c.n+1),true)} · ${
    projected?"Projected":"Recorded"
  }: ${fmt(value,c.m,true)} ${c.m.u}${
    projected?
      ` · Illustrative band ${fmt(p.low,c.m,true)}–${fmt(p.high,c.m,true)} ${c.m.u}`:
      c.m.lo==null?"":out(value,c.m)?" · Out of range":" · In range"
  }`;

  $("readout").textContent=text;
  const x=c.L+index*(c.W-c.L-c.R)/Math.max(1,c.total-1);
  $("crosshair").setAttribute("x1",x);
  $("crosshair").setAttribute("x2",x);
  $("reading-slider").value=index;
  $("reading-slider").setAttribute("aria-valuetext",text);
}

function inspectPointer(event){
  const svg=event.target.closest("#detail-svg");
  if(!svg||!chartState)return;
  const b=svg.getBoundingClientRect();
  const x=(event.clientX-b.left)/b.width*chartState.W;
  showReading(
    (x-chartState.L)/(chartState.W-chartState.L-chartState.R)*
    (chartState.total-1)
  );
}

document.addEventListener("pointermove",inspectPointer);
document.addEventListener("pointerdown",inspectPointer);
document.addEventListener("input",event=>{
  if(!provider)return;
  if(event.target.id==="reading-slider"){
    showReading(Number(event.target.value));
  }else if(event.target.id==="note-text"){
    drafts[V.pid]=event.target.value;
    $("review-note").checked=false;
  }
});
document.addEventListener("keydown",event=>{
  if(event.key==="Escape"){
    document.querySelectorAll(".tip").forEach(t=>t.dataset.dismissed="true");
  }
});
document.addEventListener("pointerover",event=>{
  const tip=event.target.closest(".tip");
  if(tip&&!tip.contains(event.relatedTarget))delete tip.dataset.dismissed;
});
document.addEventListener("focusin",event=>{
  const tip=event.target.closest(".tip");
  if(tip)delete tip.dataset.dismissed;
});

document.documentElement.dataset.theme="light";
</script>
</body>
</html>
